// Harness for the account stash moves (diablocraft-stash-audit, 1b). Not built by the server.
//
// test_stash_moves_runtime.py slices the PRODUCTION text of dc_stash.cpp (from MaxTabs() to the
// diagnostics marker) into the harness and compiles it against the doubles below:
//   * a bag model with the core's own store/merge/remove semantics (PlayerStorage.cpp: _StoreItem
//     merge marks the incoming item ITEM_REMOVED, SaveInventoryAndGoldToDB deletes it and frees it);
//   * a durable "database" that applies a transaction atomically or not at all, refuses a second
//     link for one item guid (the UNIQUE key) and can be told to fail a commit;
//   * a logout/login that discards memory and rebuilds it from the durable rows only.
// Every freed Item is poisoned: touching one aborts the run (use-after-free), and a leak check runs
// after every scenario. Scenarios are selected by argv[1]; each prints PASS or exits non-zero.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <future>
#include <iostream>
#include <map>
#include <memory>
#include <mutex>
#include <set>
#include <sstream>
#include <stdexcept>
#include <string>
#include <tuple>
#include <vector>

#define CHECK(cond)                                                                               \
    do                                                                                            \
    {                                                                                             \
        if (!(cond))                                                                              \
        {                                                                                         \
            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #cond);                          \
            std::exit(3);                                                                         \
        }                                                                                         \
    } while (0)

using uint8 = std::uint8_t;
using uint16 = std::uint16_t;
using uint32 = std::uint32_t;
using uint64 = std::uint64_t;
using int32 = std::int32_t;

static int logErrors = 0;
#define LOG_ERROR(...) (++logErrors)
#define LOG_INFO(...) ((void)0)

constexpr float INTERACTION_DISTANCE = 5.5f;
constexpr uint8 INVENTORY_SLOT_BAG_0 = 255, INVENTORY_SLOT_ITEM_START = 23, INVENTORY_SLOT_ITEM_END = 39,
                INVENTORY_SLOT_BAG_START = 19, INVENTORY_SLOT_BAG_END = 23, NULL_BAG = 0, NULL_SLOT = 255,
                EQUIPMENT_SLOT_END = 19;
enum InventoryResult { EQUIP_ERR_OK, EQUIP_ERR_INVENTORY_FULL, EQUIP_ERR_CANT_STORE };
enum ItemUpdateState { ITEM_UNCHANGED, ITEM_CHANGED, ITEM_NEW, ITEM_REMOVED };
enum { ITEM_FIELD_CONTAINED, ITEM_FIELD_OWNER, ITEM_FIELD_DURATION };
constexpr uint32 ITEM_FLAG_IS_BOUND_TO_ACCOUNT = @BOUND_FLAG@; // the core's value, read out of ItemTemplate.h

class Player;
class Item;
class WorldSession;

struct ObjectGuid
{
    uint64 value = 0;
    static const ObjectGuid Empty;
    uint64 GetCounter() const { return value; }
    bool operator==(ObjectGuid const& other) const { return value == other.value; }
};
inline const ObjectGuid ObjectGuid::Empty{};

struct ItemPosCount
{
    uint16 pos;
    uint32 count;
};
using ItemPosCountVec = std::vector<ItemPosCount>;

template <class T> std::string Text(T const& value)
{
    std::ostringstream out;
    out << value;
    return out.str();
}
inline std::string Text(uint8 value) { return std::to_string(int(value)); }
inline std::string Text(char const* value) { return value; }

inline std::string Format(std::string text) { return text; }
template <class First, class... Rest> std::string Format(std::string text, First const& first, Rest const&... rest)
{
    auto at = text.find("{}");
    if (at == std::string::npos)
        return text;
    return Format(text.substr(0, at) + Text(first) + text.substr(at + 2), rest...);
}

// ------------------------------------------------------------------ the durable rows

struct ItemRow
{
    uint64 owner = 0;
    uint32 entry = 0, count = 0;
};
using LinkKey = std::tuple<uint32, std::string, int, int>;

struct Db
{
    std::map<uint32, ItemRow> items;                  // item_instance
    std::map<uint32, std::pair<int, int>> inventory;  // character_inventory: guid -> bag, slot
    std::map<LinkKey, uint32> links;                  // dc_account_stash_item
    std::map<std::pair<uint32, std::string>, std::pair<int, uint64>> stash; // tabs, revision
    int failCommits = 0;   // the next N commits answer false and change nothing
    int commits = 0, committed = 0;
    std::vector<std::string> other; // committed statements the model does not interpret (the sweep)
    uint64 price = 0;      // dc_stash_tuning for the next tab; 0 = not set
};
static Db db;

struct Tx
{
    std::vector<std::function<bool(Db&)>> ops;
    std::vector<std::string> unknown; // statements the model does not interpret (the sweep)
    std::size_t GetSize() const { return unknown.size() + ops.size(); }
    template <class... A> void Append(std::string const& text, A const&... args)
    {
        std::string const statement = Format(text, args...);
        if (statement.rfind("DELETE FROM dc_account_stash_item WHERE account_id=", 0) == 0 &&
            statement.find(" AND tab_id=") != std::string::npos)
        {
            uint32 account = 0;
            char mode[16] = {};
            int tab = 0, slot = 0;
            std::sscanf(statement.c_str(),
                        "DELETE FROM dc_account_stash_item WHERE account_id=%u AND mode='%15[a-z]' AND tab_id=%d AND slot_id=%d",
                        &account, mode, &tab, &slot);
            std::string const m = mode;
            ops.push_back([=](Db& d) { d.links.erase({account, m, tab, slot}); return true; });
        }
        else if (statement.rfind("INSERT INTO dc_account_stash_item(", 0) == 0)
        {
            uint32 account = 0, guid = 0;
            char mode[16] = {};
            int tab = 0, slot = 0;
            std::sscanf(statement.c_str() + statement.find("VALUES("), "VALUES(%u,'%15[a-z]',%d,%d,%u)", &account, mode,
                        &tab, &slot, &guid);
            std::string const m = mode;
            ops.push_back([=](Db& d)
                          {
                              if (d.links.count({account, m, tab, slot}))
                                  return false; // PRIMARY KEY
                              for (auto const& link : d.links)
                                  if (link.second == guid)
                                      return false; // UNIQUE dc_account_stash_item_guid
                              d.links[{account, m, tab, slot}] = guid;
                              return true;
                          });
        }
        else if (statement.rfind("UPDATE dc_account_stash SET tabs_granted=", 0) == 0)
        {
            int tabs = 0;
            uint32 account = 0;
            char mode[16] = {};
            std::sscanf(statement.c_str(),
                        "UPDATE dc_account_stash SET tabs_granted=%d,revision=revision+1 WHERE account_id=%u AND mode='%15[a-z]'",
                        &tabs, &account, mode);
            std::string const m = mode;
            ops.push_back([=](Db& d) { d.stash[{account, m}].first = tabs; d.stash[{account, m}].second += 1; return true; });
        }
        else if (statement.rfind("UPDATE dc_account_stash SET revision=", 0) == 0)
        {
            uint64 revision = 0;
            uint32 account = 0;
            char mode[16] = {};
            std::sscanf(statement.c_str(), "UPDATE dc_account_stash SET revision=%lu WHERE account_id=%u AND mode='%15[a-z]'",
                        &revision, &account, mode);
            std::string const m = mode;
            ops.push_back([=](Db& d) { d.stash[{account, m}].second = revision; return true; });
        }
        else
            unknown.push_back(statement);
    }
    void Op(std::function<bool(Db&)> op) { ops.push_back(std::move(op)); }
};
using CharacterDatabaseTransaction = std::shared_ptr<Tx>;

static bool Apply(Tx const& tx)
{
    ++db.commits;
    if (db.failCommits > 0)
    {
        --db.failCommits;
        return false;
    }
    Db copy = db;
    for (auto const& op : tx.ops)
        if (!op(copy))
            return false;
    for (auto const& statement : tx.unknown)
        copy.other.push_back(statement);
    db = copy;
    ++db.committed;
    return true;
}

struct Future
{
    std::future<bool> m_future;
};

struct Field
{
    uint64 value;
    template <class T> T Get() const { return T(value); }
};
struct Row
{
    std::vector<Field> fields;
    Field const& operator[](std::size_t i) const { return fields[i]; }
};

// ------------------------------------------------------------------ items and the player

static std::set<Item*> allItems;

class Item
{
public:
    uint32 guid = 0, entry = 0, count = 1, maxStack = 1;
    uint64 owner = 0;
    ItemUpdateState state = ITEM_UNCHANGED;
    bool inWorld = true, tradeable = true, wrapped = false, nonEmptyBag = false, inTrade = false;
    uint32 duration = 0, templateFlags = 0; // item_template.Flags
    Player* player = nullptr; // whose queue it is in
    int bag = -1, slot = -1;

    Item() { allItems.insert(this); }
    ~Item() { allItems.erase(this); }
    void Live() const {} // a freed item is caught by AddressSanitizer, not by a flag
    uint32 GetEntry() const { Live(); return entry; }
    uint32 GetCount() const { Live(); return count; }
    void SetCount(uint32 value) { Live(); count = value; }
    ObjectGuid GetGUID() const { Live(); return ObjectGuid{guid}; }
    bool IsInWorld() const { Live(); return inWorld; }
    void RemoveFromWorld() { Live(); inWorld = false; }
    void AddToWorld() { Live(); inWorld = true; }
    void DestroyForPlayer(Player*) const { Live(); }
    void SetNotRefundable(Player*, bool) { Live(); }
    bool IsNotEmptyBag() const { Live(); return nonEmptyBag; }
    bool IsInTrade() const { Live(); return inTrade; }
    bool IsWrapped() const { Live(); return wrapped; }
    bool CanBeTraded() const { Live(); return tradeable; }
    bool IsBoundAccountWide() const { Live(); return (templateFlags & ITEM_FLAG_IS_BOUND_TO_ACCOUNT) != 0; } // Item.h:237
    uint32 GetUInt32Value(int field) const { Live(); return field == ITEM_FIELD_DURATION ? duration : 0; }
    void SetGuidValue(int field, ObjectGuid const& value) { Live(); if (field == ITEM_FIELD_OWNER) owner = value.value; }
    void FSetState(ItemUpdateState value) { Live(); state = value; }
    void SetState(ItemUpdateState value, Player* actor);
    void RemoveFromUpdateQueueOf(Player* actor);
    void SaveToDB(CharacterDatabaseTransaction const& tx);
    void DeleteFromInventoryDB(CharacterDatabaseTransaction const& tx);
    uint16 GetPos() const { return uint16(uint16(bag) << 8 | uint8(slot)); }
};

class Session
{
public:
    uint32 account = 7;
    bool aborted = false;
    Player* player = nullptr;
    uint32 GetAccountId() const { return account; }
    bool EconomyAborted() const { return aborted; }
    void AbortEconomy() { aborted = true; }
};

enum class HardcoreMode { Unchosen, Normal, Hardcore };

static int announced = 0, economyFails = 0;
static int canStoreCalls = 0, failCanStoreOnCall = 0;

class Player
{
public:
    Session* session = nullptr;
    uint64 guid = 55;
    bool alive = true, combat = false, atNpc = true, fallen = false;
    HardcoreMode mode = HardcoreMode::Normal;
    uint64 gold = 0;
    std::map<uint16, Item*> bags;
    std::vector<Item*> queue; // the item update queue

    Session* GetSession() const { return session; }
    bool IsAlive() const { return alive; }
    bool IsInCombat() const { return combat; }
    ObjectGuid GetGUID() const { return ObjectGuid{guid}; }
    void* FindNearestCreature(uint32, float) const { return atNpc ? const_cast<Player*>(this) : nullptr; }
    Item* GetItemByPos(uint16 pos) const
    {
        auto found = bags.find(pos);
        return found == bags.end() ? nullptr : found->second;
    }
    Item* GetItemByPos(uint8 bag, uint8 slot) const { return GetItemByPos(uint16(uint16(bag) << 8 | slot)); }
    void ItemRemovedQuestCheck(uint32, uint32) {}
    void UpdateTitansGrip() {}
    void RemoveItem(uint8 bag, uint8 slot, bool)
    {
        auto found = bags.find(uint16(uint16(bag) << 8 | slot));
        CHECK(found != bags.end());
        found->second->Live();
        found->second->bag = found->second->slot = -1;
        bags.erase(found);
    }

    InventoryResult CanStoreItem(uint8 bag, uint8 slot, ItemPosCountVec& dest, Item* item, bool swap) const
    {
        ++canStoreCalls;
        if (failCanStoreOnCall && canStoreCalls == failCanStoreOnCall)
            return EQUIP_ERR_CANT_STORE;
        dest.clear();
        uint32 left = item->GetCount();
        if (bag == NULL_BAG && slot == NULL_SLOT)
        {
            if (item->maxStack > 1)
                for (uint8 s = INVENTORY_SLOT_ITEM_START; s < INVENTORY_SLOT_ITEM_END && left; ++s)
                {
                    Item* there = GetItemByPos(INVENTORY_SLOT_BAG_0, s);
                    if (there && there->entry == item->entry && there->count < there->maxStack)
                    {
                        uint32 const take = std::min(left, there->maxStack - there->count);
                        dest.push_back({uint16(uint16(INVENTORY_SLOT_BAG_0) << 8 | s), take});
                        left -= take;
                    }
                }
            for (uint8 s = INVENTORY_SLOT_ITEM_START; s < INVENTORY_SLOT_ITEM_END && left; ++s)
                if (!GetItemByPos(INVENTORY_SLOT_BAG_0, s))
                {
                    uint32 const take = std::min(left, item->maxStack);
                    dest.push_back({uint16(uint16(INVENTORY_SLOT_BAG_0) << 8 | s), take});
                    left -= take;
                }
            return left ? EQUIP_ERR_INVENTORY_FULL : EQUIP_ERR_OK;
        }
        Item* there = GetItemByPos(bag, slot);
        uint16 const pos = uint16(uint16(bag) << 8 | slot);
        if (!there || swap)
        {
            dest.push_back({pos, left});
            return EQUIP_ERR_OK;
        }
        if (there->entry == item->entry && item->maxStack > 1 && there->count + left <= there->maxStack)
        {
            dest.push_back({pos, left});
            return EQUIP_ERR_OK;
        }
        return EQUIP_ERR_CANT_STORE;
    }

    // Player::_StoreItem, the cases the stash reaches (PlayerStorage.cpp:2689-2778).
    void MoveItemToInventory(ItemPosCountVec const& dest, Item* item, bool)
    {
        CHECK(dest.size() == 1);
        uint16 const pos = dest[0].pos;
        Item* there = GetItemByPos(pos);
        if (!there)
        {
            bags[pos] = item;
            item->bag = pos >> 8;
            item->slot = pos & 255;
            item->owner = guid;
            item->SetState(ITEM_CHANGED, this);
        }
        else
        {
            CHECK(there->entry == item->entry);
            there->SetCount(there->GetCount() + dest[0].count);
            there->SetState(ITEM_CHANGED, this);
            item->SetState(ITEM_REMOVED, this); // merged: the save deletes it
        }
    }

    // Player::SaveInventoryAndGoldToDB -> _SaveInventory -> Item::SaveToDB (Item.cpp:391-408).
    void SaveInventoryAndGoldToDB(CharacterDatabaseTransaction const& tx)
    {
        if (session->EconomyAborted())
            return;
        std::vector<Item*> pending = queue;
        for (Item* item : pending)
        {
            item->Live();
            uint32 const g = item->guid;
            if (item->state == ITEM_NEW || item->state == ITEM_CHANGED)
            {
                ItemRow const row{item->owner, item->entry, item->count};
                int const b = item->bag, s = item->slot;
                tx->Op([=](Db& d) { d.items[g] = row; d.inventory[g] = {b, s}; return true; });
                item->state = ITEM_UNCHANGED; // marked saved before the commit answers
            }
            else if (item->state == ITEM_REMOVED)
            {
                tx->Op([=](Db& d) { d.inventory.erase(g); d.items.erase(g); return true; });
                queue.erase(std::remove(queue.begin(), queue.end(), item), queue.end());
                delete item; // Item::SaveToDB's `delete this`
                continue;
            }
        }
        queue.erase(std::remove_if(queue.begin(), queue.end(), [](Item* i) { return i->state == ITEM_UNCHANGED; }),
                    queue.end());
    }

    // Rebag's SwapItem: empty cell moves, occupied cells swap. Merging is the core's and not exercised.
    void SwapItem(uint16 from, uint16 to)
    {
        Item* a = GetItemByPos(from);
        Item* b = GetItemByPos(to);
        bags.erase(from);
        bags.erase(to);
        if (a) { bags[to] = a; a->bag = to >> 8; a->slot = to & 255; a->SetState(ITEM_CHANGED, this); }
        if (b) { bags[from] = b; b->bag = from >> 8; b->slot = from & 255; b->SetState(ITEM_CHANGED, this); }
    }
};

void Item::SetState(ItemUpdateState value, Player* actor)
{
    Live();
    if (!(state == ITEM_NEW && value == ITEM_CHANGED))
        state = value;
    if (actor && std::find(actor->queue.begin(), actor->queue.end(), this) == actor->queue.end())
        actor->queue.push_back(this);
}
void Item::RemoveFromUpdateQueueOf(Player* actor)
{
    Live();
    actor->queue.erase(std::remove(actor->queue.begin(), actor->queue.end(), this), actor->queue.end());
}
void Item::SaveToDB(CharacterDatabaseTransaction const& tx)
{
    Live();
    if (state == ITEM_NEW || state == ITEM_CHANGED)
    {
        uint32 const g = guid;
        ItemRow const row{owner, entry, count};
        tx->Op([=](Db& d) { d.items[g] = row; return true; });
        state = ITEM_UNCHANGED;
    }
}
void Item::DeleteFromInventoryDB(CharacterDatabaseTransaction const& tx)
{
    Live();
    uint32 const g = guid;
    tx->Op([=](Db& d) { d.inventory.erase(g); return true; });
}

