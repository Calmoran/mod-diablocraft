namespace PlayerEconomy
{
struct Context
{
    CharacterDatabaseTransaction transaction = std::make_shared<Tx>();
    bool Dirty() const { return false; }
};
static Context* current = nullptr;
inline Context* Current() { return current; }
inline void Fail() { ++economyFails; }
inline CharacterDatabaseTransaction BeginTransaction() { return current ? current->transaction : std::make_shared<Tx>(); }
struct Scope
{
    Context context;
    bool mine = false;
    explicit Scope(Player*)
    {
        if (!current)
        {
            current = &context;
            mine = true;
        }
    }
    ~Scope()
    {
        if (mine)
            current = nullptr;
    }
};
} // namespace PlayerEconomy

namespace DC::AccountEconomy
{
inline bool IsMaterial(uint32 entry) { return entry == 7777; }
inline bool Commit(Player* player, CharacterDatabaseTransaction const& tx)
{
    bool const ok = Apply(*tx);
    if (!ok)
        player->GetSession()->AbortEconomy(); // PlayerEconomy::Flush on a failed commit
    return ok;
}
} // namespace DC::AccountEconomy

struct DatabaseDouble
{
    CharacterDatabaseTransaction BeginTransaction() { return std::make_shared<Tx>(); }
    Future AsyncCommitTransaction(CharacterDatabaseTransaction const& tx)
    {
        std::promise<bool> promise;
        promise.set_value(Apply(*tx));
        return Future{promise.get_future()};
    }
    template <class... A> void DirectExecute(std::string const& text, A const&... args)
    {
        std::string const statement = Format(text, args...);
        uint32 account = 0;
        char mode[16] = {};
        int tabs = 0;
        if (std::sscanf(statement.c_str(), "INSERT IGNORE INTO dc_account_stash(account_id,mode,tabs_granted,revision) VALUES(%u,'%15[a-z]',%d,0)",
                        &account, mode, &tabs) == 3)
            db.stash.emplace(std::make_pair(account, std::string(mode)), std::make_pair(tabs, uint64(0)));
    }
    template <class... A> std::shared_ptr<Row> Query(std::string const& text, A const&... args)
    {
        std::string const statement = Format(text, args...);
        if (statement.find("FROM dc_account_stash WHERE") != std::string::npos)
        {
            uint32 account = 0;
            char mode[16] = {};
            std::sscanf(statement.c_str() + statement.find("account_id="), "account_id=%u AND mode='%15[a-z]'", &account, mode);
            auto found = db.stash.find({account, mode});
            if (found == db.stash.end())
                return nullptr;
            return std::make_shared<Row>(Row{{Field{uint64(found->second.first)}, Field{found->second.second}}});
        }
        if (statement.find("FROM dc_stash_tuning") != std::string::npos)
            return db.price ? std::make_shared<Row>(Row{{Field{db.price}}}) : nullptr;
        return nullptr;
    }
} CharacterDatabase, WorldDatabase;

