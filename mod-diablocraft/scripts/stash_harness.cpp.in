static Item* MakeItem(uint32 guid, uint32 entry, uint32 count, uint32 maxStack)
{
    Item* item = new Item();
    item->guid = guid;
    item->entry = entry;
    item->count = count;
    item->maxStack = maxStack;
    return item;
}
static std::map<uint32, uint32> stackSizes;

#include "@HEADER@"

namespace DC::Stash
{
@PRODUCTION@
} // the production code's own anonymous namespace

// ------------------------------------------------------------------ the world the scenarios run in

namespace DC::Stash
{
constexpr uint32 Account = 7;
static Session session;
static Player player;
constexpr uint32 Potion = 2000, Sword = 3000, Helm = 3001;
// A Horadric Cache as the world migrations leave it: its entry and Flags (bounties_0003, then bounties_0004).
constexpr uint32 Cache = @CACHE_ENTRY@, CacheFlags = @CACHE_FLAGS@;

static uint16 Cell(int slot) { return uint16(uint16(INVENTORY_SLOT_BAG_0) << 8 | uint8(slot)); }
static int BagIndex(int slot) { return 25500 + slot; }

// A durable item in a bag, and the live copy of it.
static void InBag(uint32 guid, uint32 entry, uint32 count, int slot, uint32 maxStack = 1)
{
    db.items[guid] = ItemRow{player.guid, entry, count};
    db.inventory[guid] = {INVENTORY_SLOT_BAG_0, slot};
    Item* item = MakeItem(guid, entry, count, maxStack);
    item->owner = player.guid;
    item->bag = INVENTORY_SLOT_BAG_0;
    item->slot = slot;
    player.bags[Cell(slot)] = item;
}

// A durable item parked in the stash. The cache loads it on first use.
static void InStash(uint32 guid, uint32 entry, uint32 count, int tab, int slot, uint32 maxStack = 1)
{
    (void)maxStack;
    db.items[guid] = ItemRow{0, entry, count};
    db.links[{Account, "normal", tab, slot}] = guid;
    db.stash.emplace(std::make_pair(Account, std::string("normal")), std::make_pair(1, uint64(0)));
}

static void Reset()
{
    for (Item* item : std::vector<Item*>(allItems.begin(), allItems.end()))
        delete item;
    db = Db{};
    stackSizes = {{Potion, 20}};
    player = Player{};
    session = Session{};
    session.player = &player;
    player.session = &session;
    announced = economyFails = logErrors = 0;
    canStoreCalls = failCanStoreOnCall = 0;
    DC::Items::rolledRows.clear();
    containers.clear();
    operations.clear();
}

// Logout and login: everything in memory is discarded, the bags are read back from the rows.
static void Relog()
{
    Release(Key{Account, false});
    Release(Key{Account, true});
    // Memory is discarded: whatever the session still holds is freed, as a logout does.
    for (Item* item : std::vector<Item*>(allItems.begin(), allItems.end()))
        delete item;
    player.bags.clear();
    player.queue.clear();
    session.aborted = false;
    for (auto const& row : db.inventory)
    {
        ItemRow const& info = db.items.at(row.first);
        uint32 const max = stackSizes.count(info.entry) ? stackSizes[info.entry] : 1;
        Item* item = MakeItem(row.first, info.entry, info.count, max);
        item->owner = player.guid;
        item->bag = row.second.first;
        item->slot = row.second.second;
        player.bags[Cell(item->slot)] = item;
    }
}

static std::string Snapshot()
{
    std::ostringstream out;
    for (auto const& row : db.inventory)
        out << "inv " << row.first << "@" << row.second.second << "x" << db.items.at(row.first).count << ";";
    for (auto const& link : db.links)
        out << "link " << std::get<2>(link.first) << "/" << std::get<3>(link.first) << "=" << link.second << "x"
            << db.items.at(link.second).count << ";";
    return out.str();
}

static uint64 Units(uint32 entry)
{
    uint64 total = 0;
    for (auto const& row : db.inventory)
        if (db.items.at(row.first).entry == entry)
            total += db.items.at(row.first).count;
    for (auto const& link : db.links)
        if (db.items.at(link.second).entry == entry)
            total += db.items.at(link.second).count;
    return total;
}

// The durable truth: one place per item, owners say which, no row without a place.
static void DurableIsSound()
{
    std::set<uint32> places;
    for (auto const& row : db.inventory)
    {
        CHECK(places.insert(row.first).second);
        CHECK(db.items.count(row.first));
        CHECK(db.items.at(row.first).owner == player.guid);
    }
    for (auto const& link : db.links)
    {
        CHECK(places.insert(link.second).second); // in a bag AND in the stash would be a duplicate
        CHECK(db.items.count(link.second));
        CHECK(db.items.at(link.second).owner == 0); // parked: owner cleared
    }
    for (auto const& item : db.items)
        CHECK(places.count(item.first)); // a row with no place is a lost item (or an orphan)
}

// Memory agrees with the rows after a move that was answered "ok".
static void MemoryMatchesDurable()
{
    std::map<uint32, std::pair<int, int>> bagged;
    for (auto const& entry : player.bags)
    {
        bagged[entry.second->guid] = {INVENTORY_SLOT_BAG_0, entry.second->slot};
        CHECK(db.items.at(entry.second->guid).count == entry.second->count);
    }
    CHECK(bagged == db.inventory);
    auto found = containers.find(Key{Account, false});
    if (found != containers.end())
    {
        std::map<LinkKey, uint32> cached;
        for (auto const& entry : found->second.items)
            cached[{Account, "normal", entry.first / SlotsPerTab, entry.first % SlotsPerTab}] = entry.second->guid;
        CHECK(cached == db.links);
    }
}

// Items alive that nothing owns: not in the bags, not in the container, not queued.
static void NothingLeaks()
{
    std::set<Item*> owned;
    for (auto const& entry : player.bags)
        owned.insert(entry.second);
    for (auto const& cache : containers)
        for (auto const& entry : cache.second.items)
            owned.insert(entry.second);
    for (Item* item : player.queue)
        owned.insert(item);
    for (Item* item : allItems)
        CHECK(owned.count(item));
}

static bool Try(std::function<void()> action, std::string* message = nullptr)
{
    try
    {
        action();
        return true;
    }
    catch (std::exception const& error)
    {
        if (message)
            *message = error.what();
        return false;
    }
}

static bool MoveTo(char const* from, int fromIndex, char const* to, int toIndex, std::string* message = nullptr)
{
    return Try([&] { Move(&player, from, fromIndex, to, toIndex); }, message);
}

// What every failed bag-changing move owes: the session is aborted, the cache is gone, and the
// next login finds exactly what was committed before.
static void AbortedAndReloaded(std::string const& before)
{
    CHECK(session.aborted);
    CHECK(economyFails >= 1);
    CHECK(containers.empty());
    DurableIsSound();
    CHECK(Snapshot() == before);
    NothingLeaks();
    Relog();
    CHECK(Snapshot() == before);
    NothingLeaks();
}

// ------------------------------------------------------------------ the scenarios

using Scenario = std::function<void()>;
static std::map<std::string, Scenario> scenarios;

static void Define()
{
    scenarios["deposit_into_empty_slot"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        CHECK(MoveTo("bag", BagIndex(23), "stash", 3));
        DurableIsSound();
        MemoryMatchesDurable();
        NothingLeaks();
        CHECK(db.links.at({Account, "normal", 0, 3}) == 101);
        CHECK(db.items.at(101).owner == 0 && db.inventory.empty());
        CHECK(announced == 1 && !session.aborted);
        CHECK(db.stash.at({Account, "normal"}).second == 1); // revision bumped in the same commit
    };
    scenarios["deposit_auto_takes_first_free_slot"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        InStash(201, Helm, 1, 0, 0);
        CHECK(MoveTo("bag", BagIndex(23), "stash", -1));
        CHECK(db.links.at({Account, "normal", 0, 1}) == 101);
        DurableIsSound();
        MemoryMatchesDurable();
    };
    scenarios["deposit_swap_exchanges_both_items"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        InStash(201, Helm, 1, 0, 4);
        CHECK(MoveTo("bag", BagIndex(23), "stash", 4));
        DurableIsSound();
        MemoryMatchesDurable();
        NothingLeaks();
        CHECK(db.links.at({Account, "normal", 0, 4}) == 101);
        CHECK(db.inventory.at(201).second == 23);
        CHECK(announced == 1 && !session.aborted);
    };
    scenarios["withdraw_to_empty_cell_and_auto"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        InStash(202, Sword, 1, 0, 1);
        CHECK(MoveTo("stash", 0, "bag", BagIndex(30)));
        CHECK(MoveTo("stash", 1, "bag", -1));
        DurableIsSound();
        MemoryMatchesDurable();
        NothingLeaks();
        CHECK(db.inventory.at(201).second == 30);
        CHECK(db.inventory.at(202).second == 23);
        CHECK(db.links.empty());
    };
    scenarios["withdraw_swap_exchanges_both_items"] = [] {
        Reset();
        InBag(101, Sword, 1, 25);
        InStash(201, Helm, 1, 0, 2);
        CHECK(MoveTo("stash", 2, "bag", BagIndex(25)));
        DurableIsSound();
        MemoryMatchesDurable();
        NothingLeaks();
        CHECK(db.inventory.at(201).second == 25);
        CHECK(db.links.at({Account, "normal", 0, 2}) == 101);
        CHECK(announced == 1);
    };
    scenarios["rearrange_move_and_swap"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        InStash(202, Sword, 1, 0, 1);
        CHECK(MoveTo("stash", 0, "stash", 9));
        CHECK(MoveTo("stash", 9, "stash", 1)); // a swap collides on both guids unless every slot clears first
        DurableIsSound();
        CHECK(db.links.at({Account, "normal", 0, 1}) == 201 && db.links.at({Account, "normal", 0, 9}) == 202);
        MemoryMatchesDurable();
        CHECK(!session.aborted);
    };
    scenarios["rebag_moves_inside_the_bags"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        CHECK(MoveTo("bag", BagIndex(23), "bag", BagIndex(31)));
        DurableIsSound();
        MemoryMatchesDurable();
        CHECK(db.inventory.at(101).second == 31 && containers.empty());
    };

    // ---- a stackable that merges on withdraw
    scenarios["withdraw_stack_merges_into_bag_stack"] = [] {
        Reset();
        InBag(300, Potion, 10, 23, 20);
        InStash(301, Potion, 5, 0, 0, 20);
        uint64 const before = Units(Potion);
        CHECK(MoveTo("stash", 0, "bag", -1));
        DurableIsSound();
        MemoryMatchesDurable();
        NothingLeaks();
        CHECK(Units(Potion) == before && db.items.at(300).count == 15 && !db.items.count(301));
        CHECK(!session.aborted);
    };
    scenarios["withdraw_stack_merge_commit_fails"] = [] {
        Reset();
        InBag(300, Potion, 10, 23, 20);
        InStash(301, Potion, 5, 0, 0, 20);
        std::string const before = Snapshot();
        db.failCommits = 1;
        std::string message;
        CHECK(!MoveTo("stash", 0, "bag", -1, &message)); // the merged item was freed inside the save
        CHECK(message.find("disconnected") != std::string::npos);
        AbortedAndReloaded(before);
        CHECK(Units(Potion) == 15);
        // and the stash still holds its five
        CHECK(MoveTo("stash", 0, "bag", -1));
        CHECK(Units(Potion) == 15 && db.items.at(300).count == 15);
        DurableIsSound();
    };

    // ---- a failed commit, at every move
    scenarios["deposit_commit_fails"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        std::string const before = Snapshot();
        db.failCommits = 1;
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 3));
        AbortedAndReloaded(before);
        CHECK(db.links.empty() && db.inventory.count(101));
    };
    scenarios["deposit_swap_commit_fails"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        InStash(201, Helm, 1, 0, 4);
        std::string const before = Snapshot();
        db.failCommits = 1;
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 4));
        AbortedAndReloaded(before);
    };
    scenarios["withdraw_commit_fails"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        std::string const before = Snapshot();
        db.failCommits = 1;
        CHECK(!MoveTo("stash", 0, "bag", BagIndex(23)));
        AbortedAndReloaded(before);
        CHECK(db.links.size() == 1 && db.inventory.empty());
    };
    scenarios["withdraw_swap_commit_fails"] = [] {
        Reset();
        InBag(101, Sword, 1, 25);
        InStash(201, Helm, 1, 0, 2);
        std::string const before = Snapshot();
        db.failCommits = 1;
        CHECK(!MoveTo("stash", 2, "bag", BagIndex(25)));
        AbortedAndReloaded(before);
    };
    scenarios["rearrange_commit_fails_leaves_the_session_alone"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        InStash(202, Sword, 1, 0, 1);
        std::string const before = Snapshot();
        db.failCommits = 1;
        CHECK(!MoveTo("stash", 0, "stash", 1));
        CHECK(!session.aborted && containers.empty()); // nothing in the bags changed; only the cache goes
        DurableIsSound();
        CHECK(Snapshot() == before);
        CHECK(MoveTo("stash", 0, "stash", 1)); // and the next open reads the committed rows
        CHECK(db.links.at({Account, "normal", 0, 1}) == 201);
    };

    // ---- a failure between the removal and the commit
    scenarios["deposit_swap_remeasure_fails"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        InStash(201, Helm, 1, 0, 4);
        std::string const before = Snapshot();
        canStoreCalls = 0;
        failCanStoreOnCall = 2; // the first answer passes, the answer after the removal does not
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 4));
        AbortedAndReloaded(before);
        CHECK(db.commits == 0);
    };
    scenarios["withdraw_swap_remeasure_fails"] = [] {
        Reset();
        InBag(101, Sword, 1, 25);
        InStash(201, Helm, 1, 0, 2);
        std::string const before = Snapshot();
        canStoreCalls = 0;
        failCanStoreOnCall = 2;
        CHECK(!MoveTo("stash", 2, "bag", BagIndex(25)));
        AbortedAndReloaded(before);
        CHECK(db.commits == 0);
    };

    // ---- refusals before anything moved: no abort, no commit, no change
    scenarios["full_bags_refuse_withdraw_cleanly"] = [] {
        Reset();
        for (int slot = 23; slot < 39; ++slot)
            InBag(100 + slot, Sword, 1, slot);
        InStash(201, Helm, 1, 0, 0);
        std::string const before = Snapshot();
        std::string message;
        CHECK(!MoveTo("stash", 0, "bag", -1, &message));
        CHECK(message == "Your bags are full.");
        CHECK(!session.aborted && db.commits == 0 && Snapshot() == before);
        MemoryMatchesDurable();
        NothingLeaks();
    };
    scenarios["full_bags_allow_a_swap_deposit"] = [] {
        Reset();
        for (int slot = 23; slot < 39; ++slot)
            InBag(100 + slot, Sword, 1, slot);
        InStash(201, Helm, 1, 0, 0);
        CHECK(MoveTo("bag", BagIndex(23), "stash", 0));
        DurableIsSound();
        MemoryMatchesDurable();
        NothingLeaks();
        CHECK(db.inventory.at(201).second == 23 && db.links.at({Account, "normal", 0, 0}) == 123);
    };
    scenarios["full_stash_refuses_deposit"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        for (int slot = 0; slot < 70; ++slot)
            InStash(400 + slot, Helm, 1, 0, slot);
        std::string message;
        CHECK(!MoveTo("bag", BagIndex(23), "stash", -1, &message));
        CHECK(message == "The Stash is full.");
        CHECK(!session.aborted && db.commits == 0);
        MemoryMatchesDurable();
    };
    scenarios["refused_items_stay_where_they_are"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        player.bags[Cell(23)]->tradeable = false; // soulbound
        InBag(102, Sword, 1, 24);
        player.bags[Cell(24)]->wrapped = true;
        InBag(103, Sword, 1, 25);
        player.bags[Cell(25)]->duration = 3600;
        InBag(104, Sword, 1, 26);
        player.bags[Cell(26)]->nonEmptyBag = true;
        InBag(105, Sword, 1, 27);
        player.bags[Cell(27)]->inTrade = true;
        InBag(106, 7777, 1, 28); // an account material
        InBag(107, Economy::GoldBarEntry, 1, 29);
        InBag(108, Sword, 1, 30); // bound to another account
        DC::Items::rolledRows[108].boundAccount = 99;
        std::string const before = Snapshot();
        for (int slot = 23; slot <= 30; ++slot)
            CHECK(!MoveTo("bag", BagIndex(slot), "stash", -1));
        CHECK(Snapshot() == before && db.commits == 0 && !session.aborted);
        // our own account-bound item is allowed even when the stock flag says untradeable
        InBag(109, Sword, 1, 31);
        player.bags[Cell(31)]->tradeable = false;
        DC::Items::rolledRows[109].boundAccount = Account;
        CHECK(MoveTo("bag", BagIndex(31), "stash", -1));
        DurableIsSound();
    };
    scenarios["account_bound_template_goes_in_from_bags"] = [] {
        // diablocraft-rxvzd: a cache bound to the account binds in bags (CanBeTraded false); the account's stash takes it.
        Reset();
        InBag(101, Cache, 1, 23);
        player.bags[Cell(23)]->tradeable = false;
        player.bags[Cell(23)]->templateFlags = CacheFlags;
        CHECK(MoveTo("bag", BagIndex(23), "stash", -1));
        DurableIsSound();
        // a rolled item bound to another account stays out, account flag or not
        InBag(102, Cache, 1, 24);
        player.bags[Cell(24)]->tradeable = false;
        player.bags[Cell(24)]->templateFlags = CacheFlags;
        DC::Items::rolledRows[102].boundAccount = 99;
        std::string const before = Snapshot();
        std::string message;
        CHECK(!MoveTo("bag", BagIndex(24), "stash", -1, &message));
        CHECK(message == "That item is bound to another account.");
        CHECK(Snapshot() == before);
    };
    scenarios["only_the_backpack_is_addressable"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        for (int bad : {0, 18, 22, 39, 70})
            CHECK(!MoveTo("bag", 25500 + bad, "stash", 0));
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 70)); // tab 2 is not bought
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 25600));
        CHECK(!MoveTo("bag", -4, "stash", 0));
        CHECK(db.commits == 0 && !session.aborted);
    };
    scenarios["the_stash_object_and_the_player_gate_every_move"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        player.atNpc = false;
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 0));
        CHECK(MoveTo("bag", BagIndex(23), "bag", BagIndex(24))); // rearranging your own bags needs no Stash
        player.atNpc = true;
        player.alive = false;
        CHECK(!MoveTo("bag", BagIndex(24), "stash", 0));
        player.alive = true;
        player.combat = true;
        CHECK(!MoveTo("bag", BagIndex(24), "stash", 0));
        player.combat = false;
        player.mode = HardcoreMode::Unchosen;
        CHECK(!MoveTo("bag", BagIndex(24), "stash", 0));
        player.mode = HardcoreMode::Normal;
        player.fallen = true;
        CHECK(!MoveTo("bag", BagIndex(24), "stash", 0));
        player.fallen = false;
        CHECK(db.links.empty());
        CHECK(MoveTo("bag", BagIndex(24), "stash", 0));
    };
    scenarios["an_aborted_session_moves_nothing"] = [] {
        Reset();
        InBag(101, Sword, 1, 23);
        session.aborted = true;
        std::string const before = Snapshot();
        CHECK(!MoveTo("bag", BagIndex(23), "stash", 0));
        CHECK(!MoveTo("bag", BagIndex(23), "bag", BagIndex(24)));
        CHECK(db.commits == 0 && Snapshot() == before);
    };
    scenarios["hardcore_and_normal_are_separate_containers"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        player.mode = HardcoreMode::Hardcore;
        CHECK(!MoveTo("stash", 0, "bag", -1)); // the normal stash is not this account-and-mode
        InBag(101, Sword, 1, 23);
        CHECK(MoveTo("bag", BagIndex(23), "stash", 0));
        CHECK(db.links.at({Account, "hardcore", 0, 0}) == 101);
        CHECK(db.links.at({Account, "normal", 0, 0}) == 201);
        DurableIsSound();
    };

    // ---- the tab purchase
    scenarios["buytab_commit_fails_buys_nothing"] = [] {
        Reset();
        db.price = 100;
        player.gold = 5000000;
        InStash(201, Helm, 1, 0, 0);
        db.failCommits = 1;
        CHECK(Try([] { BuyTab(&player); }) == false);
        CHECK(session.aborted && economyFails >= 1);
        CHECK(db.stash.at({Account, "normal"}).first == 1); // still one tab granted
    };
    scenarios["buytab_grants_the_next_tab"] = [] {
        Reset();
        db.price = 100;
        player.gold = 5000000;
        InStash(201, Helm, 1, 0, 0);
        CHECK(Try([] { BuyTab(&player); }));
        CHECK(containers.at(Key{Account, false}).tabs == 2);
        CHECK(!session.aborted && player.gold == 4000000);
        CHECK(MoveTo("stash", 0, "stash", 70)); // tab 2 now exists
    };
    scenarios["buytab_without_a_price_or_gold_refuses"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        player.gold = 5000000;
        CHECK(!Try([] { BuyTab(&player); })); // price not set
        db.price = 100;
        player.gold = 1;
        CHECK(!Try([] { BuyTab(&player); }));
        CHECK(db.stash.at({Account, "normal"}).first == 1);
    };

    // ---- account deletion (q-1001-40)
    scenarios["account_sweep_drops_the_caches_and_prints_its_sql"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        CHECK(MoveTo("stash", 0, "stash", 1)); // loads the cache
        CHECK(containers.count(Key{Account, false}));
        AccountSweep(Account);
        CHECK(containers.empty());
        NothingLeaks();
    };
    scenarios["character_hooks_never_delete_stash_rows"] = [] {
        Reset();
        InStash(201, Helm, 1, 0, 0);
        CHECK(MoveTo("stash", 0, "stash", 1));
        Release(Key{Account, false}); // what a logout does
        DurableIsSound();
        CHECK(db.links.size() == 1);
    };
}

int Run(char const* name)
{
    Define();
    if (std::string(name) == "list")
    {
        for (auto const& entry : scenarios)
            std::printf("%s\n", entry.first.c_str());
        return 0;
    }
    auto found = scenarios.find(name);
    if (found == scenarios.end())
    {
        std::fprintf(stderr, "no scenario %s\n", name);
        return 2;
    }
    found->second();
    // the SQL the sweep sent, for the real-MySQL half of the test
    for (auto const& statement : db.other)
        std::printf("SQL %s\n", statement.c_str());
    std::printf("PASS %s\n", name);
    return 0;
}
} // namespace DC::Stash

int main(int argc, char** argv)
{
    return DC::Stash::Run(argc > 1 ? argv[1] : "list");
}
