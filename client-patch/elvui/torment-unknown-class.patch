Torment patch for ElvUI-WotLK 6.09 at 8c0ac9d0d87ba2c8aa5f9bfa3083d25569033af8 (diablocraft-i6jgl).
A class token ElvUI does not know (MONK and every later Torment class) no longer breaks ElvUI's init:
no talent tabs, no E.ClassRole row, no spellRangeCheck row. StatusReport lines are /estatus only.
Apply from the archive's top folder: patch -p1 < torment-unknown-class.patch

--- a/ElvUI/Core/API.lua
+++ b/ElvUI/Core/API.lua
@@ -90,7 +90,7 @@
 
 	for i = 1, MAX_TALENT_TABS do
 		local name, icon, pointsSpent = GetTalentTabInfo(i, isInspect, nil, talantGroup)
-		if maxPoints < pointsSpent then
+		if pointsSpent and maxPoints < pointsSpent then
 			maxPoints = pointsSpent
 			specIdx = i
 			specName = name
@@ -114,7 +114,7 @@
 
 	if type(self.ClassRole[self.myclass]) == "string" then
 		role = self.ClassRole[self.myclass]
-	elseif talentTree then
+	elseif talentTree and self.ClassRole[self.myclass] then
 		if self.myclass == "DRUID" and talentTree == 2 then
 			role = select(5, GetTalentInfo(talentTree, 22)) > 0 and "Tank" or "Melee"
 		elseif self.myclass == "DEATHKNIGHT" and talentTree == 2 then
