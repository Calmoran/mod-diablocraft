+// Torment: the class's own token for one of a unit's power slots, or nullptr. The rows come from
+// class_power_tokens.h, generated from class_resources.csv and copied into the tree by the build. Only a
+// player carries a class power: a creature with the same class id, and every slot without a row, keeps the
+// stock token.
+const char* GetClassPowerString(const CGUnit_C* unit, uint32_t powerType) {
+    if (!unit || !(unit->m_obj->m_type & TYPEMASK_PLAYER)) {
+        return nullptr;
+    }
+
+    return TormentPowers::TokenFor(unit->m_unit->m_unitFieldBytes0[1], powerType);
+}
+
+// Torment: the token a unit's slot reports: the class's own where it has one, else the stock one.
+const char* GetUnitPowerString(const CGUnit_C* unit, uint32_t powerType) {
+    const char* token = GetClassPowerString(unit, powerType);
+    return token ? token : GetPowerString(powerType);
+}
+
+// Torment: what a unit's slot is divided by for display: for a class power, its row's storage scale (slot units per
+// point), so the bar shows true points whether the server stores it x10 or 1:1; else the stock divide (Rage and Runic
+// Power show a tenth).
+uint32_t Spell_C_GetUnitPowerDisplayMod(const CGUnit_C* unit, uint32_t powerType) {
+    if (GetClassPowerString(unit, powerType)) {
+        uint32_t scale = TormentPowers::UnitsPerPointFor(unit->m_unit->m_unitFieldBytes0[1], powerType);
+        return scale ? scale : 1;
+    }
+
+    return Spell_C_GetPowerDisplayMod(powerType);
+}
