+#include <cstddef>
+#include <cstdint>
+#include <d3d9.h>
+
+struct TormentM2Draw;
+
+// A small triangle queue drawn additively (source alpha added to the frame, never dimming what is
+// behind it) with a colour on every vertex, so the GPU interpolates the falloffs and a handful of quads
+// read as a soft volume. It is drawn with the view and projection the world was drawn with, so it lands
+// where its world coordinates say. The world never occludes it through the depth buffer: the beam's
+// foot is clipped to cover on the CPU (LootBeam.cpp), and the player's own silhouette is masked out
+// per pixel.
+namespace loot_beam {
+    namespace beacon_gfx {
+        // D3DCOLOR, 0xAARRGGBB.
+        using Color = uint32_t;
+
+        // Empties the queue without drawing it.
+        void Clear();
+
+        // How many triangles are queued.
+        size_t Pending();
+
+        // Releases every D3DPOOL_DEFAULT resource (the mask target and the shaders). Called before the
+        // device resets; they are rebuilt lazily on the next use.
+        void OnDeviceLost();
+
+        // Starts a new frame's occluder mask: the previous frame's silhouette is dropped and the target
+        // stays untouched until the player's first batch stamps into it. Called once a frame.
+        void ResetOccluder();
+
+        // Stamps one batch of the active player's model into the occluder mask: the batch is drawn again,
+        // with its own vertex stream, vertex shader and transforms still bound, into a screen-sized
+        // target with a solid-fill pixel shader. The device is left as it was found.
+        void StampOccluder(const TormentM2Draw& draw);
+
+        // Queues a triangle with an independent colour at each vertex (Gouraud-interpolated).
+        void Triangle(const float a[3], const float b[3], const float c[3], Color ca, Color cb, Color cc);
+
+        // Draws everything queued and empties it, leaving the device as it was found. Returns the
+        // device's result for the draw, or 0 when nothing was drawn.
+        long Draw(IDirect3DDevice9* dev);
+    }
+}
