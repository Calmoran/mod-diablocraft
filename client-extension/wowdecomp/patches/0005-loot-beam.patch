+        void Log(LogLevel level, const char* fmt, ...) {
+            static HSLOG log = nullptr;
+            static bool opened = false;
+
+            if (!opened) {
+                opened = true;
+                SLogCreate(kLogPath, 0, &log);
+            }
+
+            if (!log) {
