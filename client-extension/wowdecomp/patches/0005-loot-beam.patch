+++ b/WoW/Source/Ui/Torment/LootBeam.h
@@ -0,0 +1,51 @@
+// The loot beam: a beam of light over every corpse that holds one of the viewing player's own
+// legendary, set or Primal Ancient drops, coloured by the tier the server puts on the corpse.
+// Port of manatactical/wxl-loot-beam at fd75b76 with Torment's patches, moved from a DLL that hooked
+// the stock client into the client's own source.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#ifndef WOW_SOURCE_UI_TORMENT_LOOTBEAM_H
+#define WOW_SOURCE_UI_TORMENT_LOOTBEAM_H
+
+#include <d3d9.h>
+
+struct TormentM2Draw;
+
+// Once a frame, from FrameTime::Update, with the frame's elapsed seconds. Reloads the .ini when it
+// changed, finds the corpses that get a beam and queues their geometry for LootBeamWorldRendered.
+void LootBeamFrameUpdate(float elapsedSec);
+
+// From CGWorldFrame::RenderWorld right after the world pass (OnWorldRender), while the world's view
+// and projection are still the engine's current ones. Draws what LootBeamFrameUpdate queued.
+// device may be null (no Direct3D device): the queue is then dropped.
+void LootBeamWorldRendered(IDirect3DDevice9* device);
+
+// From World::Preload: Leave before the preload, Enter after it.
+void LootBeamWorldEnter();
+void LootBeamWorldLeave();
+
+// After one model batch is drawn: stamps the active player's own batches into the mask that hides the
+// beam behind the character.
+void LootBeamM2BatchDrawn(const TormentM2Draw& draw);
+
+// Before the Direct3D device resets or goes away: releases the beam's D3DPOOL_DEFAULT resources.
+void LootBeamDeviceLost();
+
+// The IDirect3DDevice9 behind the engine's graphics device, or null when the engine runs another API
+// or has no device yet.
+IDirect3DDevice9* LootBeamD3dDevice();
+
+#endif
