+namespace loot_beam {
+    void FrameUpdate(float elapsedSec) {
+        if (!s_configLoaded) {
+            s_configLoaded = true;
+            LoadConfig(ExeDirectory() + kIniRelativePath);
+            Log(kLogInfo, "loot beam loaded");
+        }
+
+        ReloadConfigIfChanged();
+        s_phase += elapsedSec * s_style.pulseSpeed * kTwoPi;
+        s_phase = fmodf(s_phase, kTwoPi); // keep the phase bounded over a long session
+
+        // One frame's worth of shapes only: a frame that never reached the world pass would otherwise
+        // leave its shapes under the next one.
+        beacon_gfx::Clear();
+        s_modelPicksLeft = kModelPickBudget;
+        beacon_gfx::ResetOccluder();
+
+        // The world state is derived live each frame, not from the enter event alone.
+        s_inWorld = s_mapId >= 0;
+
+        // The player's model, refreshed once a frame, for the occluder mask (LootBeamM2BatchDrawn).
+        s_playerModel = s_inWorld ? ActivePlayerModel() : nullptr;
+
+        if (!s_style.enabled || !s_inWorld) {
+            s_beaconCount = 0;
+            s_trackedCount = 0;
+            return;
+        }
+
+        const int enumerated = ScanUnits();
+        UpdateFade(elapsedSec);
+
+        if (s_beaconCount == 0) {
+            if (!s_loggedFirstScan) {
+                s_loggedFirstScan = true;
+                Log(kLogInfo, "diag: map=%d player=%llu enumerated=%d beacons=0 (first scan)",
+                    s_mapId, static_cast<unsigned long long>(ClntObjMgrGetCurrent() ? ClntObjMgrGetActivePlayer().m_guid : 0), enumerated);
+            }
+
+            if (++s_emptyFrameStreak >= 240 && s_emptyWarnings < 5) {
+                s_emptyWarnings++;
+                s_emptyFrameStreak = 0;
+                Log(kLogWarn, "diag: 240 frames in world, enumerated=%d, no dead units -- the health field may be wrong", enumerated);
+            }
+
+            return;
+        }
+
+        s_emptyFrameStreak = 0;
+
+        if (!s_loggedFirstScan) {
+            s_loggedFirstScan = true;
+            Log(kLogInfo, "diag: map=%d player=%llu enumerated=%d beacons=%d (first scan)",
+                s_mapId, static_cast<unsigned long long>(ClntObjMgrGetActivePlayer().m_guid), enumerated, s_beaconCount);
+        }
+
+        // -1..+1 mapped into [1 - pulse, 1], so the beacon never gets brighter than the configured alpha.
+        // The per-beacon fade folds in on top.
+        const float pulseScale = 1.0f - 0.5f * s_style.pulse * (1.0f - sinf(s_phase));
+
+        for (int i = 0; i < s_trackedCount; i++) {
+            if (s_beacons[i].fade <= 0.001f) {
+                continue;
+            }
+
+            const float* rgb = s_style.color;
+            const int t = s_beacons[i].tier;
+
+            if (s_style.lootColor && t >= 0 && t < kTierCount) {
+                // A tier switched off gets no beacon at all.
+                if (!s_style.tiers[t].enabled) {
+                    continue;
+                }
+
+                rgb = s_style.tiers[t].color;
+            }
+
+            // An off-screen shaft would draw no pixel; skip it before the queue.
+            if (!BeamInView(s_beacons[i].pos, s_style)) {
+                continue;
+            }
+
+            QueueBeacon(s_beacons[i], pulseScale * s_beacons[i].fade, rgb);
+        }
+    }
+
+    void WorldRendered(IDirect3DDevice9* device) {
+        if (!s_style.enabled || !s_inWorld || s_beaconCount == 0 || !device) {
+            beacon_gfx::Clear();
+            return;
+        }
+
+        if (!s_loggedClipDiag) {
+            s_loggedClipDiag = true;
+            LogClipDiagnostic();
+        }
+
+        const size_t queued = beacon_gfx::Pending();
+        const long result = beacon_gfx::Draw(device);
+
+        if (!s_loggedFirstFlush) {
+            s_loggedFirstFlush = true;
+            Log(kLogInfo, "diag: first flush dev=%p queued=%zu result=%ld", static_cast<void*>(device), queued, result);
+        }
+    }
+
+    void WorldEnter() {
+        s_inWorld = true;
+        Log(kLogInfo, "world entered (map %d)", s_mapId);
+    }
+
+    void WorldLeave() {
+        s_inWorld = false;
+        s_beaconCount = 0;
+        s_trackedCount = 0;
+        beacon_gfx::Clear();
+    }
+
+    void M2BatchDrawn(const TormentM2Draw& draw) {
+        // Collect the active player's exact silhouette while its geometry is on the device.
+        if (!s_playerModel || s_style.throughWalls) {
+            return;
+        }
+
+        for (const CM2Model* m = draw.model; m; m = m->m_attachParent) {
+            if (m == s_playerModel) {
+                beacon_gfx::StampOccluder(draw);
+                break;
+            }
+        }
+    }
+
+    void DeviceLost() {
+        // The mask target and the shaders are D3DPOOL_DEFAULT resources the device is about to free.
+        beacon_gfx::OnDeviceLost();
+    }
+}
+
+// The entry points the engine and game code call; each forwards into the namespace so the names above
+// never meet the client's own globals.
+void LootBeamFrameUpdate(float elapsedSec) {
+    loot_beam::FrameUpdate(elapsedSec);
+}
+
+void LootBeamWorldRendered(IDirect3DDevice9* device) {
+    loot_beam::WorldRendered(device);
+}
+
+void LootBeamWorldEnter() {
+    loot_beam::WorldEnter();
+}
+
+void LootBeamWorldLeave() {
+    loot_beam::WorldLeave();
+}
+
+void LootBeamM2BatchDrawn(const TormentM2Draw& draw) {
+    loot_beam::M2BatchDrawn(draw);
+}
+
+void LootBeamDeviceLost() {
+    loot_beam::DeviceLost();
+}
diff --git a/WoW/Source/Ui/Torment/LootBeam.h b/WoW/Source/Ui/Torment/LootBeam.h
