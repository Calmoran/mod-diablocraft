diff --git a/WoW/Source/Ui/Torment/DamageTextQueue.h b/WoW/Source/Ui/Torment/DamageTextQueue.h
new file mode 100644
index 0000000..fc01276
--- /dev/null
+++ b/WoW/Source/Ui/Torment/DamageTextQueue.h
@@ -0,0 +1,132 @@
+// The queue behind TormentDamageTextRead (docs/contracts/damage-text.md in the Torment repo): the hits the engine
+// would draw a floating number or word for, held until the addon reads them, and whether the addon is reading at
+// all. The same code as the Torment module's DamageText.hpp, which its unit test runs.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace torment::damage_text
+{
+    enum class Kind : uint8_t
+    {
+        Damage,
+        Heal,
+        Word,
+    };
+
+    /// One hit, as TormentDamageTextRead hands it over.
+    struct Hit
+    {
+        Kind kind = Kind::Damage;
+        uint32_t amount = 0;
+        uint32_t school = 0;
+        bool crit = false;
+        bool periodic = false;
+        bool own = false;
+        float x = 0.0f;
+        float y = 0.0f;
+        float z = 0.0f;
+        /// The engine's word for a Kind::Word, NUL terminated; empty otherwise. The engine's own text
+        /// buffer is this size (WORLDTEXTSTRING::m_text).
+        char word[64] = {};
+
+        void SetWord(const char* text)
+        {
+            word[0] = '\0';
+            if (text)
+            {
+                std::strncpy(word, text, sizeof word - 1);
+                word[sizeof word - 1] = '\0';
+            }
+        }
+    };
+
+    /// The school mask of a hit that carries no spell: a white melee swing, a damage-shield hit.
+    constexpr uint32_t kNoSpellSchool = 1;
+
+    /// How long after the addon's last read it still counts as reading. ponytail: one frame at 2 fps; a
+    /// longer stall hands the next hits back to the engine, which then draws them as it always did.
+    constexpr uint32_t kReadingWindowMs = 500;
+
+    /// The oldest hit first; when full, a new hit drops the oldest.
+    class Queue
+    {
+    public:
+        /// ponytail: a ceiling, so a reader that stops cannot grow it; the oldest hit is the stalest.
+        static constexpr size_t kCapacity = 128;
+
+        void Push(const Hit& hit)
+        {
+            if (count_ == kCapacity)
+            {
+                head_ = (head_ + 1) % kCapacity;
+                --count_;
+            }
+            hits_[(head_ + count_) % kCapacity] = hit;
+            ++count_;
+        }
+
+        bool Pop(Hit& out)
+        {
+            if (!count_)
+                return false;
+            out = hits_[head_];
+            head_ = (head_ + 1) % kCapacity;
+            --count_;
+            return true;
+        }
+
+        void Clear()
+        {
+            head_ = 0;
+            count_ = 0;
+        }
+
+        size_t Size() const
+        {
+            return count_;
+        }
+
+    private:
+        Hit hits_[kCapacity];
+        size_t head_ = 0;
+        size_t count_ = 0;
+    };
+
+    /// Whether the addon is drawing the numbers: it read within kReadingWindowMs. Times are the client's
+    /// millisecond tick count, which wraps; the difference is taken unsigned, so a wrap reads as a short gap.
+    class Reader
+    {
+    public:
+        void MarkRead(uint32_t nowMs)
+        {
+            lastReadMs_ = nowMs;
+            hasRead_ = true;
+        }
+
+        bool Reading(uint32_t nowMs) const
+        {
+            return hasRead_ && nowMs - lastReadMs_ <= kReadingWindowMs;
+        }
+
+        /// A new interface: the engine draws until the addon's first read on it.
+        void Reset()
+        {
+            hasRead_ = false;
+        }
+
+    private:
+        uint32_t lastReadMs_ = 0;
+        bool hasRead_ = false;
+    };
+
+    /// A device (DDC) coordinate in GetCursorPosition's units, by the client's own formula
+    /// (Script_GetCursorPosition: DDCToNDCWidth(aspect compensation * 1024 * ddc), for both axes).
+    inline float CursorUnits(float ddc, float aspectCompensation, float ddcWidthScale)
+    {
+        return aspectCompensation * 1024.0f * ddc / ddcWidthScale;
+    }
+} // namespace torment::damage_text
diff --git a/WoW/Source/Ui/Torment/TormentScripts.cpp b/WoW/Source/Ui/Torment/TormentScripts.cpp
new file mode 100644
index 0000000..ecd6b16
--- /dev/null
+++ b/WoW/Source/Ui/Torment/TormentScripts.cpp
@@ -0,0 +1,162 @@
+#include "WoW/Source/Ui/Torment/TormentScripts.h"
+#include "Engine/Source/Base/Coordinate.h"
+#include "Engine/Source/FrameScript/FrameScript.h"
+#include "Engine/Source/Os/KeyState.h"
+#include "Engine/Source/Os/TimeManager.h"
+#include "Engine/Source/Tempest/C3Vector.h"
+#include "Engine/Source/lua-5.1/src/lua.h"
+#include "WoW/Source/DB/Rec/SpellRec.h"
+#include "WoW/Source/Object/ObjectClient/Unit_C.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+#include "WoW/Source/Ui/WorldFrame.h"
+
+namespace {
+    namespace dt = torment::damage_text;
+
+    // The engine starts a floating text this far below the unit's name position (PLAYERNAMEDESC::CreateWorldText).
+    constexpr float kTextStartDrop = 0.33333334f;
+
+    dt::Queue s_hits;
+    dt::Reader s_reader;
+
+    // The hit an AddWorld*Text call is deciding; null outside those calls.
+    struct PendingHit {
+        CGUnit_C* unit;
+        dt::Hit hit;
+    };
+    PendingHit s_pendingHit;
+    PendingHit* s_pending = nullptr;
+
+    const char* KindName(dt::Kind kind) {
+        switch (kind) {
+            case dt::Kind::Heal:
+                return "heal";
+            case dt::Kind::Word:
+                return "word";
+            default:
+                return "damage";
+        }
+    }
+
+    // TormentKeyDown(key): true while the key is held, false when not, nil for a name it does not know. key is
+    // a WoW binding name, as GetBindingKey returns it.
+    int32_t Script_TormentKeyDown(lua_State* L) {
+        int vk = torment::VirtualKeyFor(lua_isstring(L, 1) ? lua_tolstring(L, 1, nullptr) : nullptr);
+
+        if (vk) {
+            lua_pushboolean(L, g_osKeyState.IsDown(vk));
+        } else {
+            lua_pushnil(L);
+        }
+
+        return 1;
+    }
+
+    // TormentDamageTextRead(): the oldest queued hit as kind, amount, school, crit, periodic, own, x, y, z, word;
+    // nil when there is none. Every call counts as the addon reading.
+    int32_t Script_TormentDamageTextRead(lua_State* L) {
+        s_reader.MarkRead(OsGetAsyncTimeMs());
+        dt::Hit hit;
+
+        if (!s_hits.Pop(hit)) {
+            lua_pushnil(L);
+            return 1;
+        }
+
+        lua_pushstring(L, KindName(hit.kind));
+        lua_pushnumber(L, hit.amount);
+        lua_pushnumber(L, hit.school);
+        lua_pushboolean(L, hit.crit);
+        lua_pushboolean(L, hit.periodic);
+        lua_pushboolean(L, hit.own);
+        lua_pushnumber(L, hit.x);
+        lua_pushnumber(L, hit.y);
+        lua_pushnumber(L, hit.z);
+
+        if (hit.kind == dt::Kind::Word) {
+            lua_pushstring(L, hit.word);
+        } else {
+            lua_pushnil(L);
+        }
+
+        return 10;
+    }
+
+    // TormentWorldToScreen(x, y, z): the point projected as the engine's own world text is, in the units
+    // GetCursorPosition returns; nil behind the camera or outside the world view.
+    int32_t Script_TormentWorldToScreen(lua_State* L) {
+        CGWorldFrame* frame = CGWorldFrame::s_currentWorldFrame;
+
+        if (!frame || !frame->m_camera || !lua_isnumber(L, 1) || !lua_isnumber(L, 2) || !lua_isnumber(L, 3)) {
+            lua_pushnil(L);
+            return 1;
+        }
+
+        C3Vector world;
+        world.x = static_cast<float>(lua_tonumber(L, 1));
+        world.y = static_cast<float>(lua_tonumber(L, 2));
+        world.z = static_cast<float>(lua_tonumber(L, 3));
+        C3Vector screen;
+
+        if (!frame->GetScreenCoordinates(world, &screen, nullptr)) {
+            lua_pushnil(L);
+            return 1;
+        }
+
+        // Script_GetCursorPosition's own conversion.
+        lua_pushnumber(L, DDCToNDCWidth(CoordinateGetAspectCompensation() * 1024.0f * screen.x));
+        lua_pushnumber(L, DDCToNDCWidth(CoordinateGetAspectCompensation() * 1024.0f * screen.y));
+        return 2;
+    }
+}
+
+void TormentScriptsRegister() {
+    FrameScript_RegisterFunction("TormentKeyDown", &Script_TormentKeyDown);
+    FrameScript_RegisterFunction("TormentDamageTextRead", &Script_TormentDamageTextRead);
+    FrameScript_RegisterFunction("TormentWorldToScreen", &Script_TormentWorldToScreen);
+
+    // A new interface: nothing queued for the old one is drawn, and the engine draws until the addon reads.
+    s_hits.Clear();
+    s_reader.Reset();
+}
+
+TormentDamageTextScope::TormentDamageTextScope(CGUnit_C* unit, const WOWGUID& source, torment::damage_text::Kind kind, uint32_t amount, const SpellRec* spell, bool crit, bool periodic) {
+    s_pendingHit.unit = unit;
+    dt::Hit& hit = s_pendingHit.hit;
+    hit = dt::Hit();
+    hit.kind = kind;
+    hit.amount = amount;
+    hit.school = spell ? static_cast<uint32_t>(spell->m_schoolMask) : dt::kNoSpellSchool;
+    hit.crit = crit;
+    hit.periodic = periodic;
+    hit.own = source == ClntObjMgrGetActivePlayer();
+    s_pending = &s_pendingHit;
+}
+
+TormentDamageTextScope::~TormentDamageTextScope() {
+    s_pending = nullptr;
+}
+
+bool TormentDamageTextTake(const char* text) {
+    PendingHit* pending = s_pending;
+
+    if (!pending || !s_reader.Reading(OsGetAsyncTimeMs())) {
+        return false;
+    }
+
+    // One text per AddWorld*Text call.
+    s_pending = nullptr;
+
+    dt::Hit hit = pending->hit;
+    C3Vector position = pending->unit->GetNamePosition();
+    hit.x = position.x;
+    hit.y = position.y;
+    hit.z = position.z - kTextStartDrop;
+
+    if (hit.kind == dt::Kind::Word) {
+        hit.SetWord(text);
+    }
+
+    s_hits.Push(hit);
+    return true;
+}
diff --git a/WoW/Source/Ui/Torment/TormentScripts.h b/WoW/Source/Ui/Torment/TormentScripts.h
new file mode 100644
index 0000000..2d2ecf1
--- /dev/null
+++ b/WoW/Source/Ui/Torment/TormentScripts.h
@@ -0,0 +1,35 @@
+#ifndef WOW_SOURCE_UI_TORMENT_TORMENTSCRIPTS_H
+#define WOW_SOURCE_UI_TORMENT_TORMENTSCRIPTS_H
+
+#include <cstdint>
+#include "WoW/Source/Object/WGUID.h"
+#include "WoW/Source/Ui/Torment/DamageTextQueue.h"
+
+class CGUnit_C;
+class SpellRec;
+
+// Puts Torment's three read-only Lua globals on the script context being built: TormentKeyDown
+// (docs/contracts/client-key-state.md), TormentDamageTextRead and TormentWorldToScreen
+// (docs/contracts/damage-text.md). Called from SystemRegisterFunctions, which runs for the glue screens and
+// for every in-game interface load (login, UI reload) before any interface file, so GlueXML, FrameXML and
+// every addon see them. A new interface also empties the damage text queue, and the engine draws its own
+// numbers until the addon's first read.
+void TormentScriptsRegister();
+
+// Holds one hit for the length of a CGUnit_C::AddWorld*Text call. If the engine decides to draw it
+// (PlayerNameCreateText passes all of its checks) while the addon reads, TormentDamageTextTake queues it
+// instead. Main thread only, as the combat log is.
+class TormentDamageTextScope {
+    public:
+    TormentDamageTextScope(CGUnit_C* unit, const WOWGUID& source, torment::damage_text::Kind kind, uint32_t amount, const SpellRec* spell, bool crit, bool periodic);
+    ~TormentDamageTextScope();
+    TormentDamageTextScope(const TormentDamageTextScope&) = delete;
+    TormentDamageTextScope& operator=(const TormentDamageTextScope&) = delete;
+};
+
+// Called by PlayerNameCreateText once the engine has decided to create a world text. True when that text is
+// a held hit and the addon is reading: the hit is queued and the engine creates nothing. False for any other
+// world text, or while the addon is not reading: the engine draws as it always did.
+bool TormentDamageTextTake(const char* text);
