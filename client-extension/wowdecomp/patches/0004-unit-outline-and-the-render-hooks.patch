+#include "WoW/Source/Object/WGUID.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+#include "WoW/Source/Ui/GameUI.h"
+#include <d3d9.h>
+
+namespace unitoutline {
+    namespace gx = torment::gx;
+
+    // Blur resolution relative to the frame. Half costs a quarter of the fetches, and the upscale it
+    // implies is only visible when the sampler is left on point filtering; the outline pass states
+    // linear, so the halo, which is low-frequency by construction, survives it.
+    constexpr unsigned kBlurDivisor = 2;
+
+    // Frame pixels between blur taps, and the halo's opacity multiplier.
+    constexpr float kSpread = 1.5f;
+    constexpr float kIntensity = 2.0f;
+
+    // How far up a model's attachment chain a batch is matched against the outlined model, so weapons,
+    // shoulders and other attached models are outlined with their wearer.
+    constexpr int kMaxAttachHops = 8;
+
+    // The reaction a unit gets when there is no active player to react to: friendly.
+    constexpr int32_t kReactionNoPlayer = 5;
+
+    struct Target {
+        const CM2Model* model;
+        float color[4];
+        bool isPlayer;
+    };
+
+    class Outline {
+        public:
+        void SceneEnd(IDirect3DDevice9* device);
+        void M2BatchDrawn(const TormentM2Draw& draw);
+        void DeviceLost();
+
+        private:
+        bool EnsureResources(IDirect3DDevice9* device);
+        void Discard();
+        void ReleaseTargets();
+        void RebuildTargets();
+        void AddTarget(WOWGUID guid, const CGUnit_C* player);
+        int32_t FindTarget(const CM2Model* model) const;
+        bool ShouldStampBatch(IDirect3DDevice9* device) const;
+        void StampSilhouette(const TormentM2Draw& draw, int32_t index);
+        void OutlinePass(IDirect3DDevice9* device);
+        void ClearMask(IDirect3DDevice9* device);
+        static void ColorForReaction(int32_t reaction, float* rgba);
+
+        static constexpr int32_t kMaxTargets = 1;
+
+        Target m_targets[kMaxTargets] = {};
+        int32_t m_count = 0;
+        IDirect3DDevice9* m_device = nullptr; // the device the resources below belong to
+        gx::RenderTarget m_mask;              // the silhouette
+        gx::RenderTarget m_blurA;             // horizontal pass output
+        gx::RenderTarget m_blurB;             // vertical pass output
+        IDirect3DPixelShader9* m_fillPS = nullptr;  // stamps a batch into the mask, following its cutout
+        IDirect3DPixelShader9* m_blurPS = nullptr;  // one Gaussian, run once per axis
+        IDirect3DPixelShader9* m_applyPS = nullptr; // blurred field minus silhouette, into the frame
+        bool m_stamped = false;               // a silhouette reached the mask this frame
+    };
+
+    static Outline s_outline;
+
+    // Reaction levels as CGUnit_C::UnitReaction returns them: below 2 hostile, below 4 neutral, else
+    // friendly.
+    void Outline::ColorForReaction(int32_t reaction, float* c) {
+        if (reaction < 2) {
+            c[0] = 1.0f; c[1] = 0.0f; c[2] = 0.0f;
+        } else if (reaction < 4) {
+            c[0] = 1.0f; c[1] = 1.0f; c[2] = 0.0f;
+        } else {
+            c[0] = 0.0f; c[1] = 1.0f; c[2] = 0.0f;
+        }
+
+        c[3] = 1.0f;
+    }
+
+    void Outline::ReleaseTargets() {
+        this->m_mask.Release();
+        this->m_blurA.Release();
+        this->m_blurB.Release();
+    }
+
+    // Drops everything tied to a device. Shaders and targets hold the device alive until they are
+    // released, so this is also what lets an old device go.
+    void Outline::Discard() {
+        gx::SafeRelease(this->m_fillPS);
+        gx::SafeRelease(this->m_blurPS);
+        gx::SafeRelease(this->m_applyPS);
+        this->ReleaseTargets();
+        this->m_stamped = false;
+        this->m_count = 0;
+    }
+
+    bool Outline::EnsureResources(IDirect3DDevice9* device) {
+        // A device that is destroyed and created again, rather than reset, arrives as a new pointer.
+        // Shaders and targets belong to the device that made them, so the pointer changing is the
+        // signal to rebuild: handing the old ones to the new device faults the driver rather than
+        // failing a call.
+        if (device != this->m_device) {
+            this->Discard();
+            this->m_device = device;
+        }
+
+        if (!this->m_fillPS) {
+            this->m_fillPS = gx::CompilePixelShader(device, kFillHLSL, "ps_2_0");
+        }
+
+        if (!this->m_blurPS) {
+            this->m_blurPS = gx::CompilePixelShader(device, kBlurHLSL, "ps_2_0");
+        }
+
+        if (!this->m_applyPS) {
+            this->m_applyPS = gx::CompilePixelShader(device, kApplyHLSL, "ps_2_0");
+        }
+
+        // A freshly created target holds whatever was in that memory, and the mask is otherwise only
+        // wiped after a frame that stamped into it, so its first clear belongs here.
+        if (!this->m_mask.surface && this->m_mask.EnsureBackbufferSized(device, D3DFMT_A8R8G8B8)) {
+            this->ClearMask(device);
+        }
+
+        if (!this->m_blurA.surface) {
+            this->m_blurA.EnsureBackbufferSized(device, D3DFMT_A8R8G8B8, kBlurDivisor);
+        }
+
+        if (!this->m_blurB.surface) {
+            this->m_blurB.EnsureBackbufferSized(device, D3DFMT_A8R8G8B8, kBlurDivisor);
+        }
+
+        return this->m_fillPS && this->m_blurPS && this->m_applyPS
+            && this->m_mask.surface && this->m_blurA.surface && this->m_blurB.surface;
+    }
+
+    // The batch's model or any model it is attached to, up the attachment chain.
+    int32_t Outline::FindTarget(const CM2Model* model) const {
+        for (int32_t hop = 0; model && hop < kMaxAttachHops; hop++, model = model->m_attachParent) {
+            for (int32_t i = 0; i < this->m_count; i++) {
+                if (this->m_targets[i].model == model) {
+                    return i;
+                }
+            }
+        }
+
+        return -1;
+    }
+
+    void Outline::AddTarget(WOWGUID guid, const CGUnit_C* player) {
+        if (!guid || this->m_count >= kMaxTargets) {
+            return;
+        }
+
+        // A player's GUID has a zero high half.
+        const bool isPlayer = (guid.m_guid >> 32) == 0;
+
+        CGObject_C* object = ClntObjMgrObjectPtr(guid, isPlayer ? TYPEMASK_PLAYER : TYPEMASK_UNIT, __FILE__, __LINE__);
+
+        if (!object) {
+            return;
+        }
+
+        const CM2Model* model = object->m_worldModel;
+
+        if (!model) {
+            return;
+        }
+
+        for (int32_t i = 0; i < this->m_count; i++) {
+            if (this->m_targets[i].model == model) {
+                return;
+            }
+        }
+
+        // The unit's reaction toward the player, as the module asked it.
+        const CGUnit_C* unit = static_cast<const CGUnit_C*>(object);
+        const int32_t reaction = player ? unit->UnitReaction(player) : kReactionNoPlayer;
+
+        Target& target = this->m_targets[this->m_count];
+        target.model = model;
+        target.isPlayer = isPlayer;
+        ColorForReaction(reaction, target.color);
+        this->m_count++;
+    }
+
+    void Outline::RebuildTargets() {
+        const CGUnit_C* player = static_cast<const CGUnit_C*>(
+            ClntObjMgrObjectPtr(ClntObjMgrGetActivePlayer(), TYPEMASK_PLAYER, __FILE__, __LINE__)
+        );
+
+        this->m_count = 0;
+        this->AddTarget(CGGameUI::m_currentObjectTrack, player);
+    }
+
+    bool Outline::ShouldStampBatch(IDirect3DDevice9* device) const {
+        // Attached particles, glows and billboards draw through the same model path as the mesh. The
+        // silhouette is the geometry that claims to be solid: a blended batch is not one, and neither is
+        // a batch that declines to write depth, since an effect must not occlude what is behind it.
+        // Letting either in puts a broad card in the mask, which the blur turns into a blob next to the
+        // unit.
+        DWORD alphaBlend = 0;
+        DWORD zWrite = 0;
+        device->GetRenderState(D3DRS_ALPHABLENDENABLE, &alphaBlend);
+        device->GetRenderState(D3DRS_ZWRITEENABLE, &zWrite);
+
+        return alphaBlend == 0 && zWrite != 0;
+    }
+
+    // Draws the batch again into the mask. No state block: this runs once per model batch, and capturing
+    // the whole device to recover four render states and one constant was the module's largest CPU
+    // cost. Everything changed here is saved and put back by hand, so the device leaves this function in
+    // the state the engine's own state cache expects.
+    void Outline::StampSilhouette(const TormentM2Draw& draw, int32_t index) {
+        IDirect3DDevice9* device = draw.device;
+        const Target& target = this->m_targets[index];
+
+        IDirect3DSurface9* oldRT = nullptr;
+        IDirect3DSurface9* oldDS = nullptr;
+        IDirect3DPixelShader9* oldPS = nullptr;
+        D3DVIEWPORT9 oldViewport;
+        float oldC0[4] = {};
+        DWORD oldAlphaBlend = 0;
+        DWORD oldZEnable = 0;
+        DWORD oldZWrite = 0;
+        DWORD oldZFunc = 0;
+
+        device->GetRenderTarget(0, &oldRT);
+        device->GetDepthStencilSurface(&oldDS);
+        device->GetPixelShader(&oldPS);
+        device->GetViewport(&oldViewport);
+        device->GetPixelShaderConstantF(0, oldC0, 1);
+        device->GetRenderState(D3DRS_ALPHABLENDENABLE, &oldAlphaBlend);
+        device->GetRenderState(D3DRS_ZENABLE, &oldZEnable);
+        device->GetRenderState(D3DRS_ZWRITEENABLE, &oldZWrite);
+        device->GetRenderState(D3DRS_ZFUNC, &oldZFunc);
+
+        device->SetRenderTarget(0, this->m_mask.surface);
+
+        if (target.isPlayer) {
+            // Players: test against the scene's depth so walls hide the outline.
+            device->SetDepthStencilSurface(oldDS);
+            device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+            device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+            device->SetRenderState(D3DRS_ZFUNC, D3DCMP_LESSEQUAL);
+        } else {
+            // Creatures: seen through walls, no depth.
+            device->SetDepthStencilSurface(nullptr);
+            device->SetRenderState(D3DRS_ZENABLE, D3DZB_FALSE);
+        }
+
+        this->m_stamped = true;
+        device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+        device->SetPixelShader(this->m_fillPS);
+        device->SetPixelShaderConstantF(0, target.color, 1);
+        device->DrawIndexedPrimitive(draw.primType, draw.baseVertex, draw.minIndex, draw.numVerts, draw.startIndex, draw.primCount);
+
+        device->SetPixelShader(oldPS);
+        device->SetRenderTarget(0, oldRT);
+        device->SetDepthStencilSurface(oldDS);
+        device->SetViewport(&oldViewport);
+        device->SetRenderState(D3DRS_ALPHABLENDENABLE, oldAlphaBlend);
+        device->SetRenderState(D3DRS_ZENABLE, oldZEnable);
+        device->SetRenderState(D3DRS_ZWRITEENABLE, oldZWrite);
+        device->SetRenderState(D3DRS_ZFUNC, oldZFunc);
+        device->SetPixelShaderConstantF(0, oldC0, 1);
+
+        gx::SafeRelease(oldRT);
+        gx::SafeRelease(oldDS);
+        gx::SafeRelease(oldPS);
+    }
+
+    // mask -> blurA (horizontal) -> blurB (vertical) -> frame. A blur reaches further than a neighbour
+    // test, so the falloff is a gradient rather than a one-texel step and the width is a radius rather
+    // than a tap offset. The state block does not capture render targets, so those are saved by hand.
+    void Outline::OutlinePass(IDirect3DDevice9* device) {
+        gx::ScopedStateBlock state(device);
+        IDirect3DSurface9* oldRT = nullptr;
+        IDirect3DSurface9* oldDS = nullptr;
+        device->GetRenderTarget(0, &oldRT);
+        device->GetDepthStencilSurface(&oldDS);
+
+        device->SetRenderState(D3DRS_ZENABLE, D3DZB_FALSE);
+        device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+        device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+
+        // The blur passes have to overwrite their target completely. Four states inherited from the
+        // frame can reject a pixel instead, and any pixel not written keeps what the previous frame left
+        // there, which reads as old halos frozen in screen space.
+        device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+        device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+        device->SetRenderState(D3DRS_STENCILENABLE, FALSE);
+        device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+
+        // Sampling is inherited too. Point filtering would quantise the kernel back to texel centres and
+        // defeat the fractional offsets, and wrap addressing lets the taps at the frame's edge pull in
+        // the opposite side.
+        for (DWORD stage = 0; stage < 2; stage++) {
+            device->SetSamplerState(stage, D3DSAMP_MAGFILTER, D3DTEXF_LINEAR);
+            device->SetSamplerState(stage, D3DSAMP_MINFILTER, D3DTEXF_LINEAR);
+            device->SetSamplerState(stage, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+            device->SetSamplerState(stage, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+            device->SetSamplerState(stage, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+        }
+
+        device->SetVertexShader(nullptr);
+        device->SetDepthStencilSurface(nullptr);
+        device->SetPixelShader(this->m_blurPS);
+
+        // The step is in blur-target texels and the spread in frame pixels, hence the divisor.
+        const float step = kSpread / static_cast<float>(kBlurDivisor);
+
+        const float horizontal[4] = { 1.0f / static_cast<float>(this->m_blurA.width), 0.0f, step, 0.0f };
+        device->SetRenderTarget(0, this->m_blurA.surface);
+        device->SetTexture(0, this->m_mask.texture);
+        device->SetPixelShaderConstantF(0, horizontal, 1);
+        gx::DrawFullscreenQuad(device);
+
+        const float vertical[4] = { 0.0f, 1.0f / static_cast<float>(this->m_blurB.height), step, 0.0f };
+        device->SetRenderTarget(0, this->m_blurB.surface);
+        device->SetTexture(0, this->m_blurA.texture);
+        device->SetPixelShaderConstantF(0, vertical, 1);
+        gx::DrawFullscreenQuad(device);
+
+        const float apply[4] = { kIntensity, 0.0f, 0.0f, 0.0f };
+        device->SetRenderTarget(0, oldRT);
+        device->SetDepthStencilSurface(oldDS);
+        device->SetTexture(0, this->m_blurB.texture);
+        device->SetTexture(1, this->m_mask.texture);
+        device->SetPixelShader(this->m_applyPS);
+        device->SetPixelShaderConstantF(0, apply, 1);
+        device->SetRenderState(D3DRS_ALPHABLENDENABLE, TRUE);
+        device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
+        device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA);
+        gx::DrawFullscreenQuad(device);
+
+        device->SetPixelShader(nullptr);
+        state.Restore();
+
+        // After the restore, not before: the block captured the bindings from before this pass, so
+        // unbinding first would just be undone. The mask becomes a render target again next frame, and
+        // a surface bound as both target and texture source is invalid, which shows up as the mask
+        // keeping its contents and silhouettes piling up.
+        device->SetTexture(0, nullptr);
+        device->SetTexture(1, nullptr);
+
+        gx::SafeRelease(oldRT);
+        gx::SafeRelease(oldDS);
+    }
+
+    // Stages 0 and 1 are unbound first: the blur and the composite sampled the mask, and a surface still
+    // bound as a texture cannot be made a render target; the clear would be dropped and the silhouettes
+    // would survive into the next frame.
+    void Outline::ClearMask(IDirect3DDevice9* device) {
+        gx::ScopedStateBlock state(device);
+        IDirect3DSurface9* oldRT = nullptr;
+        IDirect3DSurface9* oldDS = nullptr;
+        device->GetRenderTarget(0, &oldRT);
+        device->GetDepthStencilSurface(&oldDS);
+
+        device->SetTexture(0, nullptr);
+        device->SetTexture(1, nullptr);
+        device->SetRenderTarget(0, this->m_mask.surface);
+        device->SetDepthStencilSurface(nullptr);
+
+        // A clear is bounded by the scissor rect the same way a draw is, so an inherited one would leave
+        // part of the mask untouched.
+        device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+        device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+        device->Clear(0, nullptr, D3DCLEAR_TARGET, 0x00000000, 1.0f, 0);
+
+        device->SetRenderTarget(0, oldRT);
+        device->SetDepthStencilSurface(oldDS);
+        gx::SafeRelease(oldRT);
+        gx::SafeRelease(oldDS);
+    }
+
+    void Outline::M2BatchDrawn(const TormentM2Draw& draw) {
+        // Not merely "are the resources there" but "are they this device's": a batch can arrive on a
+        // freshly created device before the scene end that rebuilds them.
+        if (this->m_count == 0 || !draw.device || draw.device != this->m_device) {
+            return;
+        }
+
+        if (!this->m_fillPS || !this->m_mask.surface) {
+            return;
+        }
+
+        const int32_t index = this->FindTarget(draw.model);
+
+        if (index < 0) {
+            return;
+        }
+
+        if (!this->ShouldStampBatch(draw.device)) {
+            return;
+        }
+
+        this->StampSilhouette(draw, index);
+    }
+
+    void Outline::SceneEnd(IDirect3DDevice9* device) {
+        const bool stamped = this->m_stamped;
+        this->m_stamped = false;
+
+        if (!device) {
+            return;
+        }
+
+        // First and unconditionally: it creates the shaders and targets, and nothing can be stamped until
+        // it has.
+        if (!this->EnsureResources(device)) {
+            return;
+        }
+
+        // The clear is paired with the stamping: the mask starts empty and is wiped at the end of every
+        // frame that wrote into it, so a frame that stamps nothing finds it already empty.
+        if (stamped) {
+            this->OutlinePass(device);
+            this->ClearMask(device);
+        }
+
+        this->RebuildTargets();
+    }
+
+    // The targets are D3DPOOL_DEFAULT resources, so they go before the engine resets the device; the
+    // next scene end recreates them. The pixel shaders are not pool resources and survive a reset.
+    void Outline::DeviceLost() {
+        this->ReleaseTargets();
+        this->m_stamped = false;
+    }
+}
+
+void UnitOutlineSceneEnd(IDirect3DDevice9* device) {
+    unitoutline::s_outline.SceneEnd(device);
+}
+
+void UnitOutlineM2BatchDrawn(const TormentM2Draw& draw) {
+    unitoutline::s_outline.M2BatchDrawn(draw);
+}
+
+void UnitOutlineDeviceLost() {
+    unitoutline::s_outline.DeviceLost();
+}
