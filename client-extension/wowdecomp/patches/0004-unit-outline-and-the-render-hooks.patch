new file mode 100644
index 0000000..259842b
--- /dev/null
+++ b/Engine/Source/Gx/RenderHooks.h
@@ -0,0 +1,25 @@
+#ifndef ENGINE_SOURCE_GX_RENDERHOOKS_H
+#define ENGINE_SOURCE_GX_RENDERHOOKS_H
+
+class CGxBatch;
+class CM2Model;
+
+// Three points in the engine's frame where the game draws its own additions (the unit outline and the
+// loot beam, WoW/Source/Ui/Torment). The engine keeps one function pointer per point and calls it when
+// it is set; the game sets them once at start (TormentRenderInstall). The engine does not depend on the
+// game's code, so a pointer left null draws exactly what the engine drew before.
+struct GxRenderHooks {
+    // The frame is drawn, the cursor not yet: called by the Direct3D devices' ScenePresent before
+    // ISceneEnd. d3dDevice is the IDirect3DDevice9.
+    void (*sceneEnd)(void* d3dDevice);
+    // The device is about to reset or go away: release every D3DPOOL_DEFAULT resource. Called first
+    // thing in the Direct3D devices' IReleaseD3dResources.
+    void (*deviceLost)(void* d3dDevice);
+    // One model batch has just been drawn by CM2SceneRender::DrawBatch; its vertex and index buffers
+    // are still bound, so the batch can be drawn again with other shaders.
+    void (*m2BatchDrawn)(const CM2Model* model, const CGxBatch* batch);
+};
+
+extern GxRenderHooks g_gxRenderHooks;
+
+#endif
