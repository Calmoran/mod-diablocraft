diff --git a/WoW/Source/Ui/Torment/TormentGx.cpp b/WoW/Source/Ui/Torment/TormentGx.cpp
new file mode 100644
index 0000000..433f5e6
--- /dev/null
+++ b/WoW/Source/Ui/Torment/TormentGx.cpp
@@ -0,0 +1,166 @@
+// Small Direct3D 9 helpers for the game's own render additions (see TormentGx.h).
+//
+// A port of the matching helpers in WarcraftXL/wxl-core at 748d77b (src/game/Gx.cpp) and of the state
+// guard in WarcraftXL/wxl-unit-outline at 4e8123e (src/Outline.cpp).
+//
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "WoW/Source/Ui/Torment/TormentGx.h"
+#include <d3dcompiler.h>
+#include <cstring>
+
+namespace torment {
+    namespace gx {
+        namespace {
+            // Resolved by name rather than linked: the compiler DLL is not on every machine, and a missing
+            // one must leave the effect off rather than stop the client from starting.
+            pD3DCompile ResolveD3DCompile() {
+                static const pD3DCompile compile = [] {
+                    HMODULE module = GetModuleHandleA("d3dcompiler_47.dll");
+
+                    if (!module) {
+                        module = LoadLibraryA("d3dcompiler_47.dll");
+                    }
+
+                    return module ? reinterpret_cast<pD3DCompile>(GetProcAddress(module, "D3DCompile")) : nullptr;
+                }();
+
+                return compile;
+            }
+        }
+
+        IDirect3DPixelShader9* CompilePixelShader(IDirect3DDevice9* device, const char* hlsl, const char* profile) {
+            if (!device || !hlsl) {
+                return nullptr;
+            }
+
+            const pD3DCompile compile = ResolveD3DCompile();
+
+            if (!compile) {
+                return nullptr;
+            }
+
+            ID3DBlob* code = nullptr;
+            ID3DBlob* errors = nullptr;
+            HRESULT hr = compile(hlsl, std::strlen(hlsl), nullptr, nullptr, nullptr, "main", profile, 0, 0, &code, &errors);
+            SafeRelease(errors);
+
+            if (FAILED(hr) || !code) {
+                SafeRelease(code);
+                return nullptr;
+            }
+
+            IDirect3DPixelShader9* shader = nullptr;
+            hr = device->CreatePixelShader(static_cast<const DWORD*>(code->GetBufferPointer()), &shader);
+            code->Release();
+
+            return SUCCEEDED(hr) ? shader : nullptr;
+        }
+
+        bool RenderTarget::EnsureBackbufferSized(IDirect3DDevice9* device, D3DFORMAT format, unsigned divisor) {
+            if (!device) {
+                return false;
+            }
+
+            if (this->surface) {
+                return true;
+            }
+
+            IDirect3DSurface9* backBuffer = nullptr;
+
+            if (FAILED(device->GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &backBuffer)) || !backBuffer) {
+                return false;
+            }
+
+            D3DSURFACE_DESC desc;
+            backBuffer->GetDesc(&desc);
+            backBuffer->Release();
+
+            const UINT div = divisor ? divisor : 1;
+            const UINT width = desc.Width / div > 0 ? desc.Width / div : 1;
+            const UINT height = desc.Height / div > 0 ? desc.Height / div : 1;
+
+            IDirect3DTexture9* tex = nullptr;
+
+            if (FAILED(device->CreateTexture(width, height, 1, D3DUSAGE_RENDERTARGET, format, D3DPOOL_DEFAULT, &tex, nullptr)) || !tex) {
+                return false;
+            }
+
+            IDirect3DSurface9* surf = nullptr;
+            tex->GetSurfaceLevel(0, &surf);
+
+            this->texture = tex;
+            this->surface = surf;
+            this->width = static_cast<int>(width);
+            this->height = static_cast<int>(height);
+
+            return true;
+        }
+
+        void RenderTarget::Release() {
+            SafeRelease(this->surface);
+            SafeRelease(this->texture);
+            this->width = 0;
+            this->height = 0;
+        }
+
+        void DrawFullscreenQuad(IDirect3DDevice9* device) {
+            if (!device) {
+                return;
+            }
+
+            D3DVIEWPORT9 viewport;
+            device->GetViewport(&viewport);
+            const float w = static_cast<float>(viewport.Width);
+            const float h = static_cast<float>(viewport.Height);
+
+            // XYZRHW plus one texture coordinate; the -0.5 shift lines texel centres up with pixel centres.
+            struct Vertex {
+                float x, y, z, rhw, u, v;
+            };
+
+            const Vertex quad[4] = {
+                { -0.5f, -0.5f, 0.0f, 1.0f, 0.0f, 0.0f },
+                { w - 0.5f, -0.5f, 0.0f, 1.0f, 1.0f, 0.0f },
+                { -0.5f, h - 0.5f, 0.0f, 1.0f, 0.0f, 1.0f },
+                { w - 0.5f, h - 0.5f, 0.0f, 1.0f, 1.0f, 1.0f },
+            };
+
+            device->SetFVF(D3DFVF_XYZRHW | D3DFVF_TEX1);
+            device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, sizeof(Vertex));
+        }
+
+        ScopedStateBlock::ScopedStateBlock(IDirect3DDevice9* device) {
+            if (device && SUCCEEDED(device->CreateStateBlock(D3DSBT_ALL, &this->m_state)) && this->m_state) {
+                this->m_state->Capture();
+            }
+        }
+
+        ScopedStateBlock::~ScopedStateBlock() {
+            this->Restore();
+        }
+
+        void ScopedStateBlock::Restore() {
+            if (!this->m_state) {
+                return;
+            }
+
+            this->m_state->Apply();
+            this->m_state->Release();
+            this->m_state = nullptr;
+        }
+    }
+}
diff --git a/WoW/Source/Ui/Torment/TormentGx.h b/WoW/Source/Ui/Torment/TormentGx.h
new file mode 100644
index 0000000..23d2653
--- /dev/null
+++ b/WoW/Source/Ui/Torment/TormentGx.h
@@ -0,0 +1,83 @@
+// Small Direct3D 9 helpers for the game's own render additions: runtime pixel-shader compile, a
+// back-buffer-sized render target, a fullscreen quad and a whole-device state save.
+//
+// A port of the matching helpers in WarcraftXL/wxl-core at 748d77b (src/game/Gx.cpp) and of the state
+// guard in WarcraftXL/wxl-unit-outline at 4e8123e (src/Outline.cpp), rewritten against the
+// IDirect3DDevice9 interface directly instead of wxl-core's vtable facade.
+//
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#ifndef WOW_SOURCE_UI_TORMENT_TORMENTGX_H
+#define WOW_SOURCE_UI_TORMENT_TORMENTGX_H
+
+#include <d3d9.h>
+
+namespace torment {
+    namespace gx {
+        // Releases a COM object and nulls the pointer.
+        template <class T>
+        inline void SafeRelease(T*& object) {
+            if (object) {
+                object->Release();
+                object = nullptr;
+            }
+        }
+
+        // Compiles HLSL source into a pixel shader on the device. d3dcompiler_47.dll is resolved by name
+        // on first use, so a machine without it gets a null shader (the effect stays off) instead of a
+        // load failure. Returns null on any failure.
+        IDirect3DPixelShader9* CompilePixelShader(IDirect3DDevice9* device, const char* hlsl, const char* profile);
+
+        // A render target texture sized to the back buffer (divided by a divisor). It lives in
+        // D3DPOOL_DEFAULT, so its owner releases it before the device is reset.
+        struct RenderTarget {
+            IDirect3DTexture9* texture = nullptr;
+            IDirect3DSurface9* surface = nullptr;
+            int width = 0;
+            int height = 0;
+
+            // Creates the target when it does not exist yet; true when it exists afterwards. divisor 2
+            // halves both dimensions, which a pass whose output is blurred can afford.
+            bool EnsureBackbufferSized(IDirect3DDevice9* device, D3DFORMAT format, unsigned divisor = 1);
+
+            // Releases the texture and its surface and zeroes the size, so the next Ensure recreates it.
+            void Release();
+        };
+
+        // Draws a quad covering the current viewport, texture coordinates 0..1, sampling stage 0, as
+        // pretransformed vertices with the half-pixel offset so texels map 1:1 to pixels. It leaves the
+        // FVF set and stream 0 unbound (DrawPrimitiveUP does that), so callers wrap it in a state save.
+        void DrawFullscreenQuad(IDirect3DDevice9* device);
+
+        // Captures every device state a D3DSBT_ALL state block holds and applies it back on Restore or at
+        // scope exit. Render targets and the depth-stencil surface are not part of a state block; save
+        // those by hand.
+        class ScopedStateBlock {
+            public:
+            explicit ScopedStateBlock(IDirect3DDevice9* device);
+            ~ScopedStateBlock();
+            ScopedStateBlock(const ScopedStateBlock&) = delete;
+            ScopedStateBlock& operator=(const ScopedStateBlock&) = delete;
+
+            void Restore();
+
+            private:
+            IDirect3DStateBlock9* m_state = nullptr;
+        };
+    }
+}
+
+#endif
diff --git a/WoW/Source/Ui/Torment/TormentRender.cpp b/WoW/Source/Ui/Torment/TormentRender.cpp
new file mode 100644
index 0000000..e7e6344
--- /dev/null
+++ b/WoW/Source/Ui/Torment/TormentRender.cpp
@@ -0,0 +1,65 @@
+#include "WoW/Source/Ui/Torment/TormentRender.h"
+#include "Engine/Source/Gx/CGxBuf.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/CGxDeviceD3d9Ex/CGxDeviceD3d9Ex.h"
+#include "Engine/Source/Gx/RenderHooks.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/Ui/Torment/UnitOutline.h"
+
+namespace {
+    // The Direct3D device behind the engine's device; null for OpenGL, which draws none of Torment's additions.
+    IDirect3DDevice9* ActiveD3dDevice() {
+        CGxDevice* device = g_theGxDevicePtr;
+
+        if (!device) {
+            return nullptr;
+        }
+
+        switch (device->m_api) {
+            case GxApi_D3d9:
+                return static_cast<CGxDeviceD3d*>(device)->m_d3dDevice;
+            case GxApi_D3d9Ex:
+                return static_cast<CGxDeviceD3d9Ex*>(device)->m_d3dDevice;
+            default:
+                return nullptr;
+        }
+    }
+
+    void OnSceneEnd(void* d3dDevice) {
+        UnitOutlineSceneEnd(static_cast<IDirect3DDevice9*>(d3dDevice));
+    }
+
+    void OnDeviceLost(void* d3dDevice) {
+        UnitOutlineDeviceLost();
+    }
+
+    // The values CGxDeviceD3d::Draw (and its D3d9Ex twin) has just passed to DrawIndexedPrimitive for this batch,
+    // read back from the same device members while they still hold them.
+    void OnM2BatchDrawn(const CM2Model* model, const CGxBatch* batch) {
+        CGxDevice* device = g_theGxDevicePtr;
+        IDirect3DDevice9* d3dDevice = ActiveD3dDevice();
+
+        if (!d3dDevice || !device->m_context || device->m_intF5C || !batch->m_count) {
+            return;
+        }
+
+        TormentM2Draw draw;
+        draw.device = d3dDevice;
+        draw.model = model;
+        draw.primType = CGxDeviceD3d::s_primitiveConversion[batch->m_primType];
+        draw.baseVertex = device->m_caps.unk_0010 ? 0 : static_cast<INT>(device->m_primVertexFormatBuf[0]->m_index / device->m_primVertexFormatBuf[0]->m_itemSize);
+        draw.minIndex = batch->m_minIndex;
+        draw.numVerts = batch->m_maxIndex - batch->m_minIndex + 1;
+        draw.startIndex = batch->m_start + (device->m_primIndexBuf->m_index >> 1);
+        draw.primCount = device->PrimCalcCount(batch->m_primType, batch->m_count);
+
+        UnitOutlineM2BatchDrawn(draw);
+    }
+}
+
+void TormentRenderInstall() {
+    g_gxRenderHooks.sceneEnd = OnSceneEnd;
+    g_gxRenderHooks.deviceLost = OnDeviceLost;
+    g_gxRenderHooks.m2BatchDrawn = OnM2BatchDrawn;
+}
diff --git a/WoW/Source/Ui/Torment/TormentRender.h b/WoW/Source/Ui/Torment/TormentRender.h
new file mode 100644
index 0000000..3231032
--- /dev/null
+++ b/WoW/Source/Ui/Torment/TormentRender.h
@@ -0,0 +1,26 @@
+#ifndef WOW_SOURCE_UI_TORMENT_TORMENTRENDER_H
+#define WOW_SOURCE_UI_TORMENT_TORMENTRENDER_H
+
+#include <d3d9.h>
+#include <cstdint>
+
+class CM2Model;
+
+// One model batch the engine has just drawn, as the Direct3D call that drew it: drawing it again with
+// the same values while its buffers are still bound puts the same triangles on screen.
+struct TormentM2Draw {
+    IDirect3DDevice9* device;
+    const CM2Model* model;
+    D3DPRIMITIVETYPE primType;
+    INT baseVertex;
+    UINT minIndex;
+    UINT numVerts;
+    UINT startIndex;
+    UINT primCount;
+};
+
+// Sets the engine's render hooks (Engine/Source/Gx/RenderHooks.h) to the game's handlers. Called once
+// from the engine init callback.
+void TormentRenderInstall();
+
+#endif
