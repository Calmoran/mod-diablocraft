+// Torment: a unit's Life and max Life are 64 bits on the wire as two update-field dwords (docs/contracts/life-64bit-wire.md):
+// the low dword stays where the stock client had the 32-bit field, the high dword is a new field at the end of the unit block.
+// A member of this type is the low dword in place and reads as the whole value, so the many sites that test "alive"
+// (`m_unitFieldHealth > 0`) or convert to float need no edit and cannot see half a value. Both dwords sit inside CGUnitData at the
+// fixed distance the template is given (checked by the static_asserts after CGUnitData), so the low dword finds its high one
+// from its own address. A site that stores the value in 32 bits must say so with a cast.
+template <typename T, size_t LowOffset, size_t HighOffset>
+class UnitWideField {
+    public:
+    UnitWideField() = default;
+    UnitWideField(const UnitWideField&) = delete;
+    UnitWideField& operator=(const UnitWideField&) = delete;
+
+    operator T() const {
+        const uint32_t high = *reinterpret_cast<const uint32_t*>(reinterpret_cast<const char*>(this) - LowOffset + HighOffset);
+        return static_cast<T>((static_cast<uint64_t>(high) << 32) | m_low);
+    }
+
+    // The low dword alone, as it sits in the update fields (the Life change handlers compare it with its mirrored old value).
+    uint32_t GetLow() const { return m_low; }
+
+    private:
+    uint32_t m_low;
+};
