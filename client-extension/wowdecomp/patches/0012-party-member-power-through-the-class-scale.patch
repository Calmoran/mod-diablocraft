+// Torment: what a party member's power slot is divided by when the member is out of range and only the party state holds it.
+// A class power shows through its row's storage scale (so a class stored one unit a point shows its true number), as it does
+// for a unit in range; the class is the name cache's. A member whose class is not cached yet, and any slot with no row,
+// keep the stock divide.
+static uint32_t PartyMemberPowerDisplayMod(const WOWGUID& guid, uint32_t powerType) {
+    NameCache* name = g_nameDBCache.GetRecord(guid.m_guid, WOWGUID(), nullptr, nullptr, false);
+
+    if (name) {
+        return Spell_C_GetClassPowerDisplayMod(name->m_class, powerType);
+    }
+
+    return Spell_C_GetPowerDisplayMod(powerType);
+}
