+bool ScriptMgr::ProvideFinalSpellDamage(Spell* cast, Unit* attacker, Unit* victim,
+    SpellInfo const* info, uint8 effectMask, uint32& damage, bool& critical)
+{
+    // A declining provider cannot contaminate either the next provider or stock.
+    for (auto const& script : ScriptRegistry<UnitScript>::EnabledHooks[UNITHOOK_PROVIDE_FINAL_SPELL_DAMAGE])
+    {
+        uint32 candidateDamage = damage;
+        bool candidateCritical = critical;
+        if (script->ProvideFinalSpellDamage(cast, attacker, victim, info, effectMask, candidateDamage, candidateCritical))
+        {
+            damage = candidateDamage;
+            critical = candidateCritical;
+            return true;
+        }
+    }
+    return false;
+}
