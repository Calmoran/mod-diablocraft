Reason: Let a module take an addon whisper addressed to a name nobody plays (the Lua error drop's Torment): no delivery and no "player not found" notice, which BugSack's split send would get once per chunk.
Target: AzerothCore at core-commit.txt, after patches 0001-0024 (beside 0022's GlobalScript hook). Default: stock, every whisper is looked up.

--- a/src/server/game/Handlers/ChatHandler.cpp
+++ b/src/server/game/Handlers/ChatHandler.cpp
@@ -395,6 +395,10 @@
                     break;
                 }
 
+                // a module's drop name (the Lua error drop's) takes addon whispers: no delivery, no notice per chunk
+                if (lang == LANG_ADDON && sScriptMgr->IsAddonWhisperDrop(to))
+                    return;
+
                 Player* receiver = ObjectAccessor::FindPlayerByName(to, false);
                 bool senderIsPlayer = !HasPermission(rbac::RBAC_PERM_TWO_SIDE_INTERACTION_CHAT);
                 bool receiverIsPlayer = receiver ? !receiver->GetSession()->HasPermission(rbac::RBAC_PERM_TWO_SIDE_INTERACTION_CHAT) : true;
--- a/src/server/game/Scripting/ScriptDefines/GlobalScript.cpp
+++ b/src/server/game/Scripting/ScriptDefines/GlobalScript.cpp
@@ -31,6 +31,11 @@
     CALL_ENABLED_BOOLEAN_HOOKS_WITH_DEFAULT_FALSE(GlobalScript, GLOBALHOOK_IS_INSTANCE_SHARED, script->IsInstanceShared(mapId, instanceId, maxPlayers));
 }
 
+bool ScriptMgr::IsAddonWhisperDrop(std::string const& to)
+{
+    CALL_ENABLED_BOOLEAN_HOOKS_WITH_DEFAULT_FALSE(GlobalScript, GLOBALHOOK_IS_ADDON_WHISPER_DROP, script->IsAddonWhisperDrop(to));
+}
+
 void ScriptMgr::OnGlobalItemDelFromDB(CharacterDatabaseTransaction trans, ObjectGuid::LowType itemGuid)
 {
