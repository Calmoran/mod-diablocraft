+    bool WorldObjectSpellLineTargetCheck::operator()(WorldObject* target)
+    {
+        float const dx = target->GetPositionX() - _origin.GetPositionX();
+        float const dy = target->GetPositionY() - _origin.GetPositionY();
+        float const along = dx * std::cos(_direction) + dy * std::sin(_direction);
+        float const across = -dx * std::sin(_direction) + dy * std::cos(_direction);
+        if (along < 0 || along > _length || std::abs(across) > _width * 0.5f)
