+
+bool ScriptMgr::ProvideSpellLineGeometry(Spell* cast, uint8 effect, Unit* caster, Position& origin, float& direction, float& length, float& width)
+{
+    for (auto const& script : ScriptRegistry<UnitScript>::EnabledHooks[UNITHOOK_PROVIDE_SPELL_LINE_GEOMETRY])
+    {
+        Position proposedOrigin = origin;
+        float proposedDirection = direction, proposedLength = length, proposedWidth = width;
+        if (script->ProvideSpellLineGeometry(cast, effect, caster, proposedOrigin, proposedDirection, proposedLength, proposedWidth))
+        {
+            origin = proposedOrigin; direction = proposedDirection; length = proposedLength; width = proposedWidth;
+            return true;
+        }
+    }
+    return false;
+}
