Reason: let opt-in modules supply final periodic damage and crit after the existing tick hook, retaining native delivery and stock fallback.

--- a/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
+++ b/src/server/game/Scripting/ScriptDefines/UnitScript.cpp
@@ -42,6 +42,24 @@ bool ScriptMgr::ProvideFinalSpellDamage(Spell* cast, Unit* attacker, Unit* victi
     return false;
 }
 
+bool ScriptMgr::ProvideFinalPeriodicDamage(AuraEffect const* aura, Unit* caster, Unit* target,
+    uint32& damage, bool& critical)
+{
+    // A declining provider cannot contaminate either the next provider or stock.
+    for (auto const& script : ScriptRegistry<UnitScript>::EnabledHooks[UNITHOOK_PROVIDE_FINAL_PERIODIC_DAMAGE])
+    {
+        uint32 candidateDamage = damage;
+        bool candidateCritical = critical;
+        if (script->ProvideFinalPeriodicDamage(aura, caster, target, candidateDamage, candidateCritical))
+        {
+            damage = candidateDamage;
+            critical = candidateCritical;
+            return true;
+        }
+    }
+    return false;
+}
