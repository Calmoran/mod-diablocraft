+/*
+ * Generic account-money provider. Storage and game policy belong to modules.
+ */
+#ifndef PLAYER_ECONOMY_H
+#define PLAYER_ECONOMY_H
+#include "Define.h"
+#include "DatabaseEnv.h"
+#include <functional>
+#include <memory>
+#include <map>
+class Player;
+class WorldSession;
+class WorldPacket;
+namespace PlayerEconomy
+{
+class AC_GAME_API Context
+{
+public:
+    virtual ~Context() = default;
+    CharacterDatabaseTransaction transaction = CharacterDatabase.BeginTransaction();
+    std::map<WorldSession*, Player*> players;
+    bool failed = false;
+    virtual bool Read(Player const*, uint64&) = 0;
+    virtual bool Change(Player*, uint64 amount, bool debit, bool absolute) = 0;
+    virtual bool Transfer(Player*, Player*, int64 fromDelta, int64 toDelta) = 0;
+    virtual bool CreditOffline(uint32 guid, uint64 amount) = 0;
+    virtual bool Dirty() const = 0;
+    // Append ledger changes to transaction, commit durably, update shared cache.
+    virtual bool Commit() = 0;
+};
+class AC_GAME_API Provider
+{
+public:
+    virtual ~Provider() = default;
+    virtual std::unique_ptr<Context> Begin() = 0;
+    virtual bool ReadOffline(uint32 guid, uint64& balance) = 0;
+    virtual bool AllowTransfer(uint32 fromGuid, uint32 toGuid) = 0;
+};
+AC_GAME_API void Install(Provider*);
+AC_GAME_API bool Managed();
+AC_GAME_API bool FinalizeLoad(Player*);
+AC_GAME_API bool IsEconomicOpcode(uint32);
+AC_GAME_API Context* Current();
+class AC_GAME_API Scope
+{
+public:
+    explicit Scope(Player* = nullptr, bool enabled = true);
+    ~Scope();
+    Scope(Scope const&) = delete;
+    Scope& operator=(Scope const&) = delete;
+    bool Finish();
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+AC_GAME_API uint64 Balance(Player const*);
+AC_GAME_API bool BalanceOffline(uint32 guid, uint64& balance);
+AC_GAME_API bool CreditOffline(uint32 guid, uint64 amount);
+AC_GAME_API bool Change(Player*, uint64 amount, bool debit, bool absolute = false);
+AC_GAME_API bool Transfer(Player*, Player*, uint32 offered, uint32 received);
+AC_GAME_API bool AllowTransfer(uint32 fromGuid, uint32 toGuid);
+AC_GAME_API void Enlist(Player*);
+AC_GAME_API void AfterCommit(std::function<void()>);
+AC_GAME_API void OnRollback(std::function<void()>);
+AC_GAME_API void Fail();
+AC_GAME_API bool Flush();
+AC_GAME_API bool DeferPacket(WorldSession*, WorldPacket const*);
+AC_GAME_API CharacterDatabaseTransaction BeginTransaction();
+AC_GAME_API void CommitTransaction(CharacterDatabaseTransaction const&);
+}
+#endif
