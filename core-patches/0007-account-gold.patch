+namespace
+{
+bool CanClaimAccountMail(Mail const* mail,Player* player)
+{
+    if (!PlayerEconomy::Managed()) return true;
+    if (mail->messageType==MAIL_NORMAL)
+        return PlayerEconomy::AllowTransfer(mail->sender,player->GetGUID().GetCounter());
+    if (mail->messageType==MAIL_AUCTION)
+    {
+        std::istringstream subject(mail->subject);
+        uint32 entry=0,zero=0,answer=0;char one=0,two=0;
+        if (!(subject>>entry>>one>>zero>>two>>answer) || one!=':' || two!=':') return false;
+        // Refunds return the bidder's own escrow, not the seller's assets.
+        if (answer==AUCTION_WON || answer==AUCTION_SUCCESSFUL)
+        {
+            std::istringstream body(mail->body);uint64 raw=0;
+            if (!(body>>std::hex>>raw)) return false;
+            ObjectGuid principal(raw);
+            return principal.IsPlayer() && PlayerEconomy::AllowTransfer(principal.GetCounter(),player->GetGUID().GetCounter());
+        }
+    }
+    return true;
+}
