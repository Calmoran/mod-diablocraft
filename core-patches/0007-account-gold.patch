+#include "PlayerEconomy.h"
+#include "Player.h"
+#include "WorldSession.h"
+#include "WorldPacket.h"
+#include "Log.h"
+#include "Opcodes.h"
+#include "ScriptMgr.h"
+#include "World.h"
+#include <algorithm>
+#include <exception>
+#include <vector>
+namespace PlayerEconomy
+{
+namespace
+{
+Provider* provider = nullptr;
+struct PendingPacket
+{
+    WorldSession* session;
+    WorldPacket packet;
+};
+struct Active
+{
+    std::unique_ptr<Context> context;
+    std::vector<PendingPacket> packets;
+    std::vector<std::function<void()>> success, rollback;
+    int exceptions = std::uncaught_exceptions();
+};
+thread_local Active* active = nullptr;
+}
+struct Scope::Impl
+{
+    Active state;
+};
+bool FinalizeLoad(Player* player)
+{
+    if (!Managed()) return true;
+    Scope accountOperation(player);
+    uint32 limit=sWorld->getIntConfig(CONFIG_MAX_HONOR_POINTS);
+    uint32 value=player->GetHonorPoints();
+    if (value>limit)
+    {
+        int32 copperPerPoint=sWorld->getIntConfig(CONFIG_MAX_HONOR_POINTS_MONEY_PER_POINT);
+        if (copperPerPoint && !player->ModifyMoney(int64(value-limit)*copperPerPoint)) return false;
+        player->SetHonorPoints(limit);
+    }
+    return accountOperation.Finish();
+}
+void Install(Provider* value) { provider = value; }
+bool Managed() { return provider != nullptr; }
+Context* Current() { return active ? active->context.get() : nullptr; }
+Scope::Scope(Player* actor, bool enabled)
+{
+    if (!enabled || !provider || active)
+        return;
+    impl_ = std::make_unique<Impl>();
+    impl_->state.context = provider->Begin();
+    active = &impl_->state;
+    if (actor)
+        active->context->players[actor->GetSession()] = actor;
+}
+Scope::~Scope()
+{
+    if (impl_)
+        Finish();
+}
+bool Scope::Finish()
+{
+    if (!impl_)
+        return !Current() || !Current()->failed;
+    bool ok = Flush();
+    active = nullptr;
+    impl_.reset();
+    return ok;
+}
+bool Flush()
+{
+    if (!active)
+        return true;
+    auto* frame = active;
+    auto& state = *active;
+    auto& context = *state.context;
+    context.failed |= std::uncaught_exceptions() > state.exceptions;
+    for (auto const& [session,player] : context.players)
+        context.failed |= session->GetPlayer()!=player || session->EconomyAborted();
+    bool changed = context.Dirty() || context.transaction->GetSize() != 0;
+    if (!context.failed && changed)
+    {
+        try
+        {
+            for (auto const& [session,player] : context.players)
+                player->SaveToDB(context.transaction, false, false);
+            context.failed = !context.Commit();
+        }
+        catch (std::exception const& error)
+        {
+            context.failed = true;
+            LOG_ERROR("entities.player", "Account operation exception: {}", error.what());
+        }
+    }
+    bool ok = !context.failed;
+    active = nullptr;
+    if (!ok)
+    {
+        for (auto it = state.rollback.rbegin(); it != state.rollback.rend(); ++it)
+            (*it)();
+        // Staged inventory/quest/skill mutations are discarded by logout without
+        // saving. Reconnect loads the last committed character and account state.
+        for (auto const& [session,player] : context.players)
+            session->AbortEconomy();
+        LOG_ERROR("entities.player", "Account operation failed; affected sessions must reload committed state.");
+    }
+    else
+    {
+        for (auto& callback : state.success)
+            callback();
+        for (auto& pending : state.packets)
+            pending.session->SendPacket(&pending.packet);
+    }
+    state.success.clear();
+    state.rollback.clear();
+    state.packets.clear();
+    if (ok)
+        context.transaction = CharacterDatabase.BeginTransaction();
+    active = frame;
+    return ok;
+}
+void Enlist(Player* player)
+{
+    if (Current() && player)
+        Current()->players[player->GetSession()] = player;
+}
+uint64 Balance(Player const* player)
+{
+    if (!player)
+        return 0;
+    if (!provider)
+        return player->GetMoney();
+    Scope scope;
+    uint64 value = 0;
+    try { return Current()->Read(player, value) ? value : 0; }
+    catch (std::exception const&) { Fail(); return 0; }
+}
+bool BalanceOffline(uint32 guid, uint64& balance)
+{
+    try { return provider && provider->ReadOffline(guid, balance); }
+    catch (std::exception const&) { Fail(); return false; }
+}
+bool Change(Player* player, uint64 amount, bool debit, bool absolute)
+{
+    if (!provider || !player || player->GetSession()->EconomyAborted())
+        return false;
+    Scope scope(player);
+    Enlist(player);
+    bool ok = false;
+    try { ok = !Current()->failed && Current()->Change(player, amount, debit, absolute); }
+    catch (std::exception const&) { Fail(); }
+    if (!ok)
+        Current()->failed = true;
+    return scope.Finish() && ok;
+}
+bool Transfer(Player* from, Player* to, uint32 offered, uint32 received)
+{
+    if (!provider || !from || !to)
+        return false;
+    Scope scope(from);
+    Enlist(to);
+    // Preserve the four native money-hook legs, but apply their net results
+    // atomically so shared principals and near-UINT64_MAX exchanges are valid.
+    auto leg = [](Player* player, int64 delta)
+    {
+        if (!delta) return delta;
+        if (delta >= INT32_MIN && delta <= INT32_MAX)
+        {
+            int32 legacy = int32(delta);
+            sScriptMgr->OnPlayerMoneyChanged(player, legacy);
+            delta = legacy;
+        }
+        sScriptMgr->OnPlayerMoneyChangedWide(player, delta);
+        return delta;
+    };
+    int64 aDebit=leg(from,-int64(offered)),aCredit=leg(from,received);
+    int64 bDebit=leg(to,-int64(received)),bCredit=leg(to,offered);
+    auto sum = [](int64 a, int64 b, int64& out)
+    {
+        if ((b>0 && a>INT64_MAX-b) || (b<0 && a<INT64_MIN-b)) return false;
+        out=a+b; return true;
+    };
+    int64 a=0,b=0;
+    bool ok = false;
+    try
+    {
+        ok = !Current()->failed && from->HasEnoughMoney(offered) && to->HasEnoughMoney(received) &&
+            AllowTransfer(from->GetGUID().GetCounter(), to->GetGUID().GetCounter()) &&
+            sum(aDebit,aCredit,a) && sum(bDebit,bCredit,b) &&
+            Current()->Transfer(from,to,a,b);
+    }
+    catch (std::exception const&) { Fail(); }
+    if (!ok)
+        Current()->failed = true;
+    return scope.Finish() && ok;
+}
+bool AllowTransfer(uint32 from, uint32 to)
+{
+    try { return !provider || provider->AllowTransfer(from, to); }
+    catch (std::exception const&) { Fail(); return false; }
+}
+bool CreditOffline(uint32 guid, uint64 amount)
+{
+    if (!provider) return false;
+    Scope scope;
+    bool ok=false;
+    try { ok=!Current()->failed && Current()->CreditOffline(guid,amount); }
+    catch (std::exception const&) { Fail(); }
+    if (!ok) Fail();
+    return scope.Finish() && ok;
+}
+bool IsEconomicOpcode(uint32 opcode)
+{
+    switch (opcode)
+    {
+        case CMSG_BUY_ITEM: case CMSG_BUY_ITEM_IN_SLOT: case CMSG_SELL_ITEM:
+        case CMSG_BUYBACK_ITEM: case CMSG_BUY_BANK_SLOT: case CMSG_GOSSIP_SELECT_OPTION:
+        case CMSG_TRAINER_BUY_SPELL: case CMSG_REPAIR_ITEM: case CMSG_SET_TRADE_GOLD:
+        case CMSG_ACCEPT_TRADE: case CMSG_SEND_MAIL: case CMSG_MAIL_TAKE_MONEY:
+        case CMSG_MAIL_TAKE_ITEM: case CMSG_MAIL_RETURN_TO_SENDER:
+        case CMSG_AUCTION_SELL_ITEM: case CMSG_AUCTION_PLACE_BID: case CMSG_AUCTION_REMOVE_ITEM:
+        case CMSG_QUESTGIVER_CHOOSE_REWARD: case CMSG_QUESTGIVER_REQUEST_REWARD:
+        case CMSG_QUESTGIVER_COMPLETE_QUEST: case CMSG_ACTIVATETAXI:
+        case CMSG_ACTIVATETAXIEXPRESS: case CMSG_BUY_STABLE_SLOT: case CMSG_PETITION_BUY:
+        case CMSG_ALTER_APPEARANCE: case CMSG_MESSAGECHAT: case CMSG_ITEM_REFUND:
+        case CMSG_LOOT_MONEY: case CMSG_UNLEARN_TALENTS: case MSG_SAVE_GUILD_EMBLEM:
+            return true;
+        default: return false;
+    }
+}
+void AfterCommit(std::function<void()> callback)
+{
+    if (active)
+        active->success.push_back(std::move(callback));
+    else
+        callback();
+}
+void OnRollback(std::function<void()> callback)
+{
+    if (active)
+        active->rollback.push_back(std::move(callback));
+}
+void Fail()
+{
+    if (Current())
+        Current()->failed = true;
+}
+bool DeferPacket(WorldSession* session, WorldPacket const* packet)
+{
+    if (!active || !packet)
+        return false;
+    if (session->EconomyAborted())
+        return true;
+    active->packets.push_back({session, *packet});
+    return true;
+}
+CharacterDatabaseTransaction BeginTransaction()
+{
+    return Current() ? Current()->transaction : CharacterDatabase.BeginTransaction();
+}
+void CommitTransaction(CharacterDatabaseTransaction const& transaction)
+{
+    if (!Current())
+        CharacterDatabase.CommitTransaction(transaction);
+    else if (transaction != Current()->transaction)
+    {
+        // Never silently commit a second transaction beside an account payment.
+        Current()->failed = true;
+        LOG_ERROR("entities.player", "Account operation received an unenlisted transaction.");
+    }
+}
+}
