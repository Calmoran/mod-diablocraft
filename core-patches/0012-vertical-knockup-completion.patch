 void EffectMovementGenerator::Finalize(Unit* unit)
 {
+    bool const completed = m_launched && unit->movespline->GetId() == m_splineId &&
+        unit->movespline->Finalized() && unit->movespline->timePassed() == unit->movespline->Duration();
