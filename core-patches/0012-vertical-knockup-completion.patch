+void MotionMaster::MoveVerticalKnockback(float height, uint32 id)
+{
+    if (!_owner->IsCreature() || _owner->IsClientControlled() || !std::isfinite(height) || height <= 0)
+        return;
+    Movement::MoveSplineInit init(_owner);
+    init.MoveTo(_owner->GetPositionX(), _owner->GetPositionY(), _owner->GetPositionZ());
+    init.SetParabolic(height, 0);
+    init.SetOrientationFixed(true);
+    init.SetVerticalDuration(std::max(1, int32(2000.f * std::sqrt(2.f * height / Movement::gravity))));
+    Mutate(new EffectMovementGenerator(init, id), MOTION_SLOT_CONTROLLED);
+}
