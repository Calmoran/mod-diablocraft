+// Native 64-bit Life (core patch 0027): Life and hits are 64 bits. A value that enters a 32-bit field (a spell
+// value, an aura amount, an AI argument, a packet) saturates at that field's maximum instead of wrapping.
+inline uint32 LifeToUInt32(uint64 value)
+{
+    return value > std::numeric_limits<uint32>::max() ? std::numeric_limits<uint32>::max() : static_cast<uint32>(value);
+}
+
+inline int32 LifeToInt32(uint64 value)
+{
+    return value > static_cast<uint64>(std::numeric_limits<int32>::max()) ? std::numeric_limits<int32>::max() : static_cast<int32>(value);
+}
+
+// A 32-bit consumer (a script hook, an AI callback, a proc) sees a 64-bit amount through a view: the amount saturated at
+// 4,294,967,295. A consumer that changes its view replaces the amount with what it set; one that leaves it alone leaves
+// the exact amount as it was.
+template <typename Consumer>
+inline void ApplyThroughView(uint64& amount, Consumer&& consumer)
+{
+    uint32 const before = LifeToUInt32(amount);
+    uint32 after = before;
+    consumer(after);
+    if (after != before)
+        amount = after;
+}
+
+// floor (or ceil, with roundUp) of value * numerator / denominator in 128-bit whole numbers, saturating at 2^64 - 1.
+// denominator must not be 0.
+inline uint64 LifeMulDiv(uint64 value, uint64 numerator, uint64 denominator, bool roundUp = false)
+{
+    unsigned __int128 const scaled = (static_cast<unsigned __int128>(value) * numerator + (roundUp ? denominator - 1 : 0)) / denominator;
+    return scaled > std::numeric_limits<uint64>::max() ? std::numeric_limits<uint64>::max() : static_cast<uint64>(scaled);
+}
+
+// The part of a hit that lies past the Life it lands on.
+inline uint64 LifeOverkill(uint64 damage, uint64 health)
+{
+    return damage > health ? damage - health : 0;
+}
+
+// floor(base * pct / 100) in whole numbers: CalculatePct multiplies in float, which is off by hundreds at 10^12.
+// A pct of 0 or less gives 0.
+inline uint64 CalculateLifePct(uint64 base, int64 pct)
+{
+    return pct <= 0 ? 0 : LifeMulDiv(base, static_cast<uint64>(pct), 100);
+}
