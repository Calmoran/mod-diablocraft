+uint64 Unit::ExpectedLife(uint64 before, uint64 maximum, int64 change)
+{
+    if (change < 0)
+    {
+        uint64 const loss = static_cast<uint64>(-(change + 1)) + 1;
+        return loss >= before ? 0 : before - loss;
+    }
+
+    uint64 const room = maximum > before ? maximum - before : 0;
+    return static_cast<uint64>(change) < room ? before + static_cast<uint64>(change) : maximum;
+}
+
+void Unit::CheckLifeAfter(Unit const* source, SpellInfo const* spell, uint64 before, int64 change)
+{
+    if (!IsCreature() || !IsAlive())
+        return;
+
+    uint64 const expected = ExpectedLife(before, GetMaxHealth(), change);
+    if (GetHealth() == expected)
+        return;
+
+    static std::atomic<uint32> seen{0};
+    uint32 const times = ++seen;
+    // a narrowing that is hit again and again would fill the log: the first hundred are written, then one in a thousand
+    if (times > 100 && times % 1000 != 0)
+        return;
+
+    LOG_WARN("entities.unit", "[DC life] creature {} {}: Life after is {}, expected {} (before {}, change {}, max {}); source {} spell {}; seen {} times",
+        GetEntry(), GetGUID().ToString(), GetHealth(), expected, before, change, GetMaxHealth(),
+        source ? source->GetGUID().ToString() : std::string("none"), spell ? spell->Id : 0, times);
+}
