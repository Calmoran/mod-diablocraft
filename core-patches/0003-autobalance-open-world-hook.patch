+namespace
+{
+void ModuleDefaults(Creature* creature, double& health, double& damage)
+{
+    bool boss = creature->IsDungeonBoss() || creature->isWorldBoss();
+    health = boss ? StatModifier_Boss_Global * StatModifier_Boss_Health : StatModifier_Global * StatModifier_Health;
+    damage = boss ? StatModifier_Boss_Global * StatModifier_Boss_Damage : StatModifier_Global * StatModifier_Damage;
+}
+}
+
+bool ABScriptMgr::IsModuleScaled(Creature* creature) const
+{
+    return creature && creature->CustomData.GetDefault<AutoBalanceCreatureInfo>("AutoBalanceCreatureInfo")->moduleScalingOwner;
+}
+
+bool ABScriptMgr::SelectModuleCreatureScaling(Creature* creature)
+{
+    auto* info = creature->CustomData.GetDefault<AutoBalanceCreatureInfo>("AutoBalanceCreatureInfo");
+    if (!info->moduleScalingSelected)
+    {
+        info->moduleScalingSelected = true;
+        for (auto const& [id, script] : ScriptRegistry<ABModuleScript>::ScriptPointerList)
+        {
+            double health, damage;
+            ModuleDefaults(creature, health, damage);
+            if (script->OnModuleCreatureScaling(creature, health, damage))
+            {
+                info->moduleScalingOwner = script;
+                break;
+            }
+        }
+    }
+    return info->moduleScalingOwner != nullptr;
+}
+
+bool ABScriptMgr::CaptureModuleCreatureBase(Creature* creature)
+{
+    if (!IsModuleScaled(creature)) return false;
+    auto* info = creature->CustomData.GetDefault<AutoBalanceCreatureInfo>("AutoBalanceCreatureInfo");
+    info->moduleBaseHealth = creature->GetMaxHealth();
+    return RefreshCreatureScaling(creature);
+}
+
+bool ABScriptMgr::RefreshCreatureScaling(Creature* creature)
+{
+    if (!IsModuleScaled(creature)) return false;
+    auto* info = creature->CustomData.GetDefault<AutoBalanceCreatureInfo>("AutoBalanceCreatureInfo");
+    if (!info->moduleBaseHealth) return false;
+    double health, damage;
+    ModuleDefaults(creature, health, damage);
+    if (!info->moduleScalingOwner->OnModuleCreatureScaling(creature, health, damage))
+    {
+        LOG_ERROR("module.AutoBalance", "Module scaling owner refused refresh for creature {}; ownership cannot change until recreation", creature->GetEntry());
+        return false;
+    }
+    double life = std::floor(info->moduleBaseHealth * health);
+    if (!std::isfinite(life) || life < 1 || life > std::numeric_limits<uint32>::max() ||
+        !std::isfinite(damage) || damage < 0)
+    {
+        LOG_ERROR("module.AutoBalance", "Module scaling overflow/invalid multiplier for creature {}: base {}, health {}, damage {}", creature->GetEntry(), info->moduleBaseHealth, health, damage);
+        return false;
+    }
+    double fraction = creature->GetMaxHealth() ? double(creature->GetHealth()) / creature->GetMaxHealth() : 1;
+    uint32 maximum = static_cast<uint32>(life);
+    creature->SetMaxHealth(maximum);
+    creature->SetCreateHealth(maximum);
+    creature->SetStatFlatModifier(UNIT_MOD_HEALTH, BASE_VALUE, static_cast<float>(maximum));
+    creature->ResetPlayerDamageReq();
+    creature->SetHealth(creature->IsAlive() ? std::max<uint32>(1, static_cast<uint32>(std::floor(maximum * fraction))) : 0);
+    info->moduleDamageMultiplier = damage;
+    return true;
+}
